	-- theme dots reflect live state
	local function dotColor(on) return on and T.accent or T.off end

	local function section(title)
		local y = cursor
		cursor = cursor + SEC_H
		mk("TextLabel", {
			Size = UDim2.new(1, -(PAD * 2), 0, 14),
			Position = UDim2.fromOffset(PAD, y + 8),
			BackgroundTransparency = 1,
			Text = title,
			TextColor3 = T.accent,
			TextSize = 10,
			Font = Enum.Font and Enum.Font.GothamBold or nil,
			TextXAlignment = TXL,
		}, body)
	end

	local function rowShell(h)
		local y = cursor
		cursor = cursor + h + 4
		local row = mk("Frame", {
			Size = UDim2.new(1, -(PAD * 2), 0, h),
			Position = UDim2.fromOffset(PAD, y),
			BackgroundColor3 = T.row,
			BorderSizePixel = 0,
		}, body)
		corner(row, 6)
		return row
	end

	local function toggleRow(label, get, set)
		local row = rowShell(ROW_H)
		mk("TextLabel", {
			Size = UDim2.new(1, -70, 1, 0),
			Position = UDim2.fromOffset(9, 0),
			BackgroundTransparency = 1,
			Text = label,
			TextColor3 = T.text,
			TextSize = 12,
			TextXAlignment = TXL,
		}, row)
		local pill = mk("TextButton", {
			Size = UDim2.fromOffset(46, 18),
			Position = UDim2.new(1, -54, 0.5, -9),
			BackgroundColor3 = T.off,
			BorderSizePixel = 0,
			Text = "OFF",
			TextColor3 = T.dim,
			TextSize = 10,
			Font = Enum.Font and Enum.Font.GothamBold or nil,
		}, row)
		corner(pill, 9)
		local function paint()
			local on = get()
			pill.BackgroundColor3 = on and T.accent or T.off
			pill.Text = on and "ON" or "OFF"
			pill.TextColor3 = on and T.bg or T.dim
		end
		pill.MouseButton1Click:Connect(function()
			set(not get())
			paint()
			refresh_ui()
		end)
		paint()
		return paint
	end

	local function stepperRow(label, get, onDec, onInc)
		local row = rowShell(ROW_H)
		mk("TextLabel", {
			Size = UDim2.new(1, -110, 1, 0),
			Position = UDim2.fromOffset(9, 0),
			BackgroundTransparency = 1,
			Text = label,
			TextColor3 = T.text,
			TextSize = 12,
			TextXAlignment = TXL,
		}, row)
		local value = mk("TextLabel", {
			Size = UDim2.fromOffset(46, 18),
			Position = UDim2.new(1, -98, 0.5, -9),
			BackgroundTransparency = 1,
			Text = tostring(get()),
			TextColor3 = T.accent,
			TextSize = 12,
			Font = Enum.Font and Enum.Font.GothamBold or nil,
		}, row)
		local function btn(x, txt, fn)
			local b = mk("TextButton", {
				Size = UDim2.fromOffset(22, 18),
				Position = UDim2.new(1, x, 0.5, -9),
				BackgroundColor3 = T.off,
				BorderSizePixel = 0,
				Text = txt,
				TextColor3 = T.text,
				TextSize = 13,
			}, row)
			corner(b, 5)
			b.MouseButton1Click:Connect(function()
				fn()
				value.Text = tostring(get())
				refresh_ui()
			end)
		end
		btn(-46, "−", onDec)
		btn(-22, "+", onInc)
		return function() value.Text = tostring(get()) end
	end

	local function buttonRow(label, onClick, tint)
		local row = mk("TextButton", {
			Size = UDim2.new(1, -(PAD * 2), 0, 26),
			Position = UDim2.fromOffset(PAD, cursor),
			BackgroundColor3 = T.row,
			BorderSizePixel = 0,
			Text = label,
			TextColor3 = tint or T.text,
			TextSize = 11,
			Font = Enum.Font and Enum.Font.GothamBold or nil,
		}, body)
		cursor = cursor + 30
		corner(row, 6)
		row.MouseButton1Click:Connect(function()
			local ok, err = pcall(onClick)
			if not ok then log("action failed: %s", tostring(err)) end
			refresh_ui()
		end)
		return row
	end

	-- TRAIN
	section("TRAIN")
	toggleRow("Auto punch", function() return CONFIG.train.enabled end, function(v) CONFIG.train.enabled = v end)
	stepperRow("Clicks / sec", function() return CONFIG.train.cps end,
		function() CONFIG.train.cps = math.max(1, CONFIG.train.cps - 1) end,
		function() CONFIG.train.cps = math.min(40, CONFIG.train.cps + 1) end)
	toggleRow("Face dummy", function() return CONFIG.train.face end, function(v) CONFIG.train.face = v end)
	toggleRow("Warp to dummy", function() return CONFIG.train.warp end, function(v) CONFIG.train.warp = v end)

	-- ECONOMY
	section("ECONOMY")
	toggleRow("Auto rebirth", function() return CONFIG.economy.rebirth end, function(v) CONFIG.economy.rebirth = v end)
	stepperRow("Rebirth at", function() return CONFIG.economy.rebirthMin end,
		function() CONFIG.economy.rebirthMin = math.max(0, CONFIG.economy.rebirthMin - 500) end,
		function() CONFIG.economy.rebirthMin = CONFIG.economy.rebirthMin + 500 end)
	toggleRow("Auto claim", function() return CONFIG.economy.claim end, function(v) CONFIG.economy.claim = v end)
	buttonRow("Rebirth now", function() castRebirth() end, T.accent)

	-- SCOUT
	section("SCOUT")
	buttonRow("Scan remotes + prompts", function()
		scanRemotes()
		buildList()
	end, T.accent)

	local listHolder = mk("Frame", {
		Size = UDim2.new(1, -(PAD * 2), 0, 112),
		Position = UDim2.fromOffset(PAD, cursor),
		BackgroundColor3 = T.bg,
		BorderSizePixel = 0,
	}, body)
	cursor = cursor + 116
	corner(listHolder, 6)
	stroke(listHolder, T.off, 0.4)

	local list = mk("ScrollingFrame", {
		Size = UDim2.new(1, -4, 1, -4),
		Position = UDim2.fromOffset(2, 2),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(0, 0, 0, 100),
	}, listHolder)

	function buildList()
		for _, c in ipairs(list:GetChildren()) do
			if c.ClassName ~= "UIListLayout" and c.ClassName ~= "UIPadding" then pcall(function() c:Destroy() end) end
		end
		local y = 0
		local shown = 0
		for _, e in ipairs(STATE.remotes) do
			if shown >= 22 then break end
			shown = shown + 1
			local label = string.format("%s%s", e.name, e.result and ("  " .. e.result) or "")
			if #label > 46 then label = string.sub(label, 1, 46) .. "…" end
			local b = mk("TextButton", {
				Size = UDim2.new(1, -2, 0, 18),
				Position = UDim2.fromOffset(1, y),
				BackgroundColor3 = T.row,
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				Text = label,
				TextColor3 = e.group == "unknown" and T.dim or T.text,
				TextSize = 10,
				TextXAlignment = TXL,
			}, list)
			y = y + 19
			b.MouseButton1Click:Connect(function()
				b.TextColor3 = T.accent
				task.spawn(function()
					probe(e, function()
						buildList()
					end)
				end)
			end)
		end
		if y == 0 then
			mk("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = "no remotes yet — press scan",
				TextColor3 = T.dim,
				TextSize = 10,
			}, list)
			y = 20
		end
		list.CanvasSize = UDim2.new(0, 0, 0, y)
	end

	buttonRow("Probe top 3 (measures Fury)", function()
		local shown = 0
		for _, e in ipairs(STATE.remotes) do
			if shown >= 3 then break end
			if e.group ~= "unknown" then
				shown = shown + 1
				probe(e)
			end
		end
		buildList()
	end)

	buttonRow("Copy scan to clipboard", function()
		local txt = dumpText()
		if type(setclipboard) == "function" then
			pcall(setclipboard, txt)
			log("scan copied (%d bytes)", #txt)
		else
			log("%s", txt)
		end
	end)

	-- SYSTEM
	section("SYSTEM")
	toggleRow("Anti-AFK", function() return CONFIG.system.antiafk end, function(v) CONFIG.system.antiafk = v end)
	setStatus = function(text, color)
		local lbl = body:FindFirstChild("Status")
		if not lbl then
			lbl = mk("TextLabel", {
				Name = "Status",
				Size = UDim2.new(1, -(PAD * 2), 0, 16),
				Position = UDim2.fromOffset(PAD, cursor),
				BackgroundTransparency = 1,
				Text = "",
				TextColor3 = T.dim,
				TextSize = 10,
				TextXAlignment = TXL,
			}, body)
			cursor = cursor + 20
		end
		lbl.Text = text or ""
		lbl.TextColor3 = color or T.dim
	end
	setStatus("booting…")

	local collapsed = false
	local function setCollapsed(v)
		local full = HEAD_H + BODY_H
		collapsed = v and true or false
		body.Visible = not collapsed
		local target = UDim2.fromOffset(PANEL_W, v and HEAD_H or full)
		if TweenService then
			local ok = pcall(function()
				TweenService:Create(panel, TweenInfo.new(0.16), { Size = target }):Play()
			end)
			if not ok then panel.Size = target end
		else
			panel.Size = target
		end
		fold.Text = collapsed and "▸" or "▾"
	end
	setCollapsed(false)
	fold.MouseButton1Click:Connect(function()
		setCollapsed(not collapsed)
	end)

	-- drag
	local dragging, dragFrom, panelFrom = false, nil, nil
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragFrom = UIS:GetMouseLocation()
			panelFrom = panel.AbsolutePosition or Vector2.new(0, 0)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local now_pos = UIS:GetMouseLocation()
		local cam = rawget(workspace, "CurrentCamera")
		local vp = (cam and rawget(cam, "ViewportSize")) or Vector2.new(1080, 1920)
		local nx = math.clamp(panelFrom.X + (now_pos.X - dragFrom.X), 0, math.max(0, vp.X - PANEL_W))
		local ny = math.clamp(panelFrom.Y + (now_pos.Y - dragFrom.Y), 0, math.max(0, vp.Y - HEAD_H))
		panel.Position = UDim2.fromOffset(nx, ny)
	end)

	body.CanvasSize = UDim2.new(0, 0, 0, cursor + 12)

	refresh_ui = function()
		local d = STATE.dummy
		local f = furyStat()
		setStatus(string.format("%s | fury %s | clicks %d | rb %d",
			d and tostring(d.name) or "no dummy",
			f and tostring(math.floor(f)) or "—",
			STATE.counters.clicks, STATE.counters.rebirths), d and T.dim or T.bad)
		dotAim.BackgroundColor3 = dotColor(CONFIG.train.enabled)
		dotEsp.BackgroundColor3 = dotColor(CONFIG.economy.rebirth)
	end
	refresh_ui()
	buildList()
	return panel
end

