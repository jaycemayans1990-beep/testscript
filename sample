local list = Instance.new("Frame")
list.Position = UDim2.fromOffset(6, 28)
list.Size = UDim2.new(1, -12, 1, -34)
list.BackgroundTransparency = 1
list.Parent = panel
do
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 2)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = list
end

local SPECS = {}
local function addSpec(label, action, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 22)
	btn.BackgroundColor3 = ROW_BG
	btn.BorderSizePixel = 0
	btn.TextColor3 = Color3.fromRGB(228, 236, 244)
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.Text = "  " .. label
	btn.LayoutOrder = order
	do
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
	end
	btn.Parent = list
	btn.MouseButton1Click:Connect(function()
		pcall(action)
	end)
	table.insert(SPECS, btn)
	return btn
end

local function refreshAll()
	local s = SPECS
	local texts = {
		"  ESP  [" .. (CONFIG.esp.enabled and "on" or "off") .. "]",
		"  AIM  [" .. (CONFIG.aim.enabled and "on" or "off") .. "]",
		"  MODE  " .. CONFIG.aim.mode,
		"  TRIGGER  [" .. (CONFIG.aim.triggerbot and "on" or "off") .. "]",
		"  SKELETON  [" .. (CONFIG.esp.skeleton and "on" or "off") .. "]",
		"  CHAMS  [" .. (CONFIG.esp.chams and "on" or "off") .. "]",
		"  TEAM CHECK  [" .. (CONFIG.esp.teamCheck and "on" or "off") .. "]",
		"  FOV -20  (" .. CONFIG.aim.fov .. ")",
		"  FOV +20  (" .. CONFIG.aim.fov .. ")",
		"  SMOOTH -  (" .. string.format("%.2f", CONFIG.aim.smooth) .. ")",
		"  SMOOTH +  (" .. string.format("%.2f", CONFIG.aim.smooth) .. ")",
	}
	for i, btn in ipairs(s) do
		if texts[i] then btn.Text = texts[i] end
	end
	title.Text = "  AX · fov " .. CONFIG.aim.fov .. " · sm " .. string.format("%.2f", CONFIG.aim.smooth)
end

addSpec("ESP", function() setEsp(not CONFIG.esp.enabled); refreshAll() end, 1)
addSpec("AIM", function() setAim(not CONFIG.aim.enabled); refreshAll() end, 2)
addSpec("MODE", function()
	CONFIG.aim.mode = (CONFIG.aim.mode == "camera") and "mouse" or "camera"
	refreshAll()
end, 3)
addSpec("TRIG", function() CONFIG.aim.triggerbot = not CONFIG.aim.triggerbot; refreshAll() end, 4)
addSpec("SKEL", function() CONFIG.esp.skeleton = not CONFIG.esp.skeleton; refreshAll() end, 5)
addSpec("CHAM", function() CONFIG.esp.chams = not CONFIG.esp.chams; refreshAll() end, 6)
addSpec("TEAM", function()
	local v = not CONFIG.esp.teamCheck
	CONFIG.esp.teamCheck = v
	CONFIG.aim.teamCheck = v
	refreshAll()
end, 7)
addSpec("FOV -", function() CONFIG.aim.fov = math.max(20, CONFIG.aim.fov - 20); refreshAll() end, 8)
addSpec("FOV +", function() CONFIG.aim.fov = math.min(1200, CONFIG.aim.fov + 20); refreshAll() end, 9)
addSpec("SM -", function() CONFIG.aim.smooth = math.clamp(CONFIG.aim.smooth - 0.05, 0.02, 1); refreshAll() end, 10)
addSpec("SM +", function() CONFIG.aim.smooth = math.clamp(CONFIG.aim.smooth + 0.05, 0.02, 1); refreshAll() end, 11)

refreshAll()

-- drag (mouse + touch)
local dragging, dragFrom, panelFrom = false, nil, nil
table.insert(CONNS, title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragFrom = input.Position
		panelFrom = panel.Position
	end
end))
table.insert(CONNS, UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragFrom
		panel.Position = UDim2.new(panelFrom.X.Scale, panelFrom.X.Offset + d.X, panelFrom.Y.Scale, panelFrom.Y.Offset + d.Y)
	end
end))
table.insert(CONNS, UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end))

