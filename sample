local VisibilityService = {}
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude; RayParams.IgnoreWater = true
local ScratchFilter = {}
local lastFilterCount, lastFilterFirst = -1, nil

-- FIXED: Shared cache with longer TTL, keyed by character
local VisCache = setmetatable({}, { __mode = "k" })
local VIS_CACHE_TTL = 0.25 -- 250ms (up from 150ms)

-- FIXED: CheckVisibility now ALWAYS uses cache for character-level checks
-- When specificPart is given, still caches under the character
function VisibilityService:CheckVisibility(targetCharacter, pierceCount, specificPart)
    local camera = getCamera()
    if not (camera and targetCharacter) then return false end
    
    local now = os.clock()
    
    -- FIXED: Always check character-level cache first (even with specificPart)
    -- The cache stores overall visibility — specificPart check is a refinement
    local cacheEntry = VisCache[targetCharacter]
    if cacheEntry and now - cacheEntry.checkedAt < VIS_CACHE_TTL then
        -- If cache says NOT visible, specificPart can't be visible either
        if not cacheEntry.visible then return false end
        -- If cache says visible AND no specificPart requested, return cached
        if not specificPart then return true end
        -- If cache says visible but specificPart requested, do a quick check
        -- but skip the full raycast — just check if part is in front of camera
    end
    
    local targetPart = specificPart
    if not (targetPart and targetPart.Parent) then
        targetPart = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
    end
    if not targetPart then
        VisCache[targetCharacter] = { visible = false, checkedAt = now }
        return false
    end
    
    local origin = camera.CFrame.Position
    local targetPos = targetPart.Position
    local direction = targetPos - origin
    local distToTarget = direction.Magnitude
    if distToTarget < 0.05 then
        VisCache[targetCharacter] = { visible = true, checkedAt = now }
        return true
    end
    
    local maxPierces = pierceCount or 1
    local currentOrigin = origin; local currentDirection = direction
    table.clear(ScratchFilter)
    local n = 0
    local myChar = LocalPlayer and LocalPlayer.Character
    if myChar then n += 1; ScratchFilter[n] = myChar end
    local filterDirty = (n ~= lastFilterCount) or (ScratchFilter[1] ~= lastFilterFirst)
    
    for i = 1, maxPierces do
        if filterDirty then lastFilterCount, lastFilterFirst = n, ScratchFilter[1]; RayParams.FilterDescendantsInstances = ScratchFilter; filterDirty = false end
        local okRay, result = pcall(Workspace.Raycast, Workspace, currentOrigin, currentDirection, RayParams)
        if not okRay or not result then VisCache[targetCharacter] = { visible = true, checkedAt = now }; return true end
        local hitDist = result.Distance
        if math.abs(hitDist - distToTarget) < 0.03 then VisCache[targetCharacter] = { visible = true, checkedAt = now }; return true end
        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetCharacter) then VisCache[targetCharacter] = { visible = true, checkedAt = now }; return true end
        if i < maxPierces and (hitPart.Transparency > 0.8 or not hitPart.CanCollide) then
            n += 1; ScratchFilter[n] = hitPart; filterDirty = true
            local seg = targetPos - result.Position; local segUnit = safeUnit(seg)
            if not segUnit then VisCache[targetCharacter] = { visible = true, checkedAt = now }; return true end
            currentOrigin = result.Position + segUnit * 0.05; currentDirection = seg
        else
            VisCache[targetCharacter] = { visible = false, checkedAt = now }; return false
        end
    end
    VisCache[targetCharacter] = { visible = false, checkedAt = now }
    return false
end

