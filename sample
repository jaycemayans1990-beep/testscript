-- FIXED: Find best adorn part — Head > UpperTorso > Root
local function findAdornPart(char)
    -- Try Head variants first
    for _, name in ipairs({"Head", "head", "Hat"}) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    -- Try torso
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") then return torso end
    -- Fallback to root
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then return root end
    return nil
end

-- FIXED: Grace period — don't destroy visuals immediately when enemy becomes invalid
local VISUAL_GRACE = 1.0 -- keep visuals for 1s after enemy becomes invalid

function ESPService:ProcessESP()
    if not State.ESP and not State.ESPName then return end
    local now = os.clock()
    local players = Players:GetPlayers()
    
    -- FIXED: Round-robin visibility updates — max 2 full raycasts per frame
    local visUpdatesThisFrame = 0
    local MAX_VIS_UPDATES = 2
    
    for i = 1, #players do
        local player = players[i]
        if player ~= LocalPlayer then
            local char = player.Character
            if not char then
                -- Character gone — grace period before cleanup
                local entry = self.Cache[player]
                if entry then
                    if not entry._invalidSince then entry._invalidSince = now end
                    if now - entry._invalidSince > VISUAL_GRACE then
                        destroyEntryVisuals(entry)
                        self.Cache[player] = nil
                    end
                end
            else
                local entry = self.Cache[player]
                if not entry or entry.Character ~= char then
                    -- New character — clear old, create new entry
                    if entry then destroyEntryVisuals(entry) end
                    entry = {
                        Character = char,
                        Visible = false, LastCheck = 0,
                        Highlight = nil, NameTag = nil,
                        ShownVisible = nil, Label = nil,
                        AdornPart = nil,
                        _invalidSince = nil
                    }
                    self.Cache[player] = entry
                end
                
                local isEnemy = isValidEnemy(player)
                local showESP = State.ESP
                local showName = State.ESPName
                
                -- FIXED: Grace period for enemy becoming invalid
                if not isEnemy then
                    if not entry._invalidSince then entry._invalidSince = now end
                    if now - entry._invalidSince < VISUAL_GRACE then
                        isEnemy = true -- keep showing during grace
                    end
                else
                    entry._invalidSince = nil -- reset grace
                end
                
                if not isEnemy or (not showESP and not showName) then
                    -- Grace expired or ESP fully off — destroy visuals
                    if entry.Highlight then entry.Highlight:Destroy(); entry.Highlight = nil end
                    if entry.NameTag then entry.NameTag:Destroy(); entry.NameTag = nil end
                    entry.Label = nil; entry.ShownVisible = nil; entry.AdornPart = nil
                else
                    -- FIXED: Round-robin visibility updates
                    if visUpdatesThisFrame < MAX_VIS_UPDATES and now - entry.LastCheck >= 0.35 then
                        entry.Visible = VisibilityService:CheckVisibility(char, 5, nil)
                        entry.LastCheck = now
                        visUpdatesThisFrame += 1
                    end
                    
                    -- ---- HIGHLIGHT ----
                    if showESP then
                        local hl = entry.Highlight
                        -- FIXED: Only recreate if actually missing (not if parent changed temporarily)
                        if not hl then
                            hl = char:FindFirstChild("ESP_Highlight")
                            if hl then
                                entry.Highlight = hl -- reuse existing
                            else
                                hl = Instance.new("Highlight")
                                hl.Name = "ESP_Highlight"
                                hl.FillTransparency = 0.25
                                hl.Parent = char
                                entry.Highlight = hl
                                ESPRegistry[hl] = true
                                entry.ShownVisible = nil -- force color update
                            end
                        end
                        if hl and hl.Parent == char then
                            if entry.ShownVisible ~= entry.Visible then
                                hl.FillColor = entry.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                                hl.OutlineColor = entry.Visible and self.OUTLINE_VISIBLE or self.OUTLINE_OBSTRUCTED
                                entry.ShownVisible = entry.Visible
                            end
                        else
                            -- Highlight parent wrong — recreate
                            if hl then pcall(hl.Destroy, hl) end
                            entry.Highlight = nil; entry.ShownVisible = nil
                        end
                    elseif entry.Highlight then
                        entry.Highlight:Destroy(); entry.Highlight = nil
                        entry.ShownVisible = nil
                    end
                    
                    -- ---- NAME TAG ----
                    if showName then
                        -- FIXED: Find adorn part with fallback (Head → Torso → Root)
                        local adornPart = entry.AdornPart
                        if not adornPart or adornPart.Parent ~= char then
                            adornPart = findAdornPart(char)
                            entry.AdornPart = adornPart
                        end
                        
                        if adornPart then
                            local nt = entry.NameTag
                            if not nt or nt.Parent ~= char then
                                -- Destroy old if exists
                                if nt then pcall(nt.Destroy, nt) end
                                -- Build new
                                entry.NameTag = buildNameTag(char, adornPart, player.DisplayName or player.Name)
                                nt = entry.NameTag
                                entry.Label = nt and nt:FindFirstChild("TagLabel") or nil
                            end
                            -- Update color
                            local label = entry.Label
                            if label and label.Parent == nt then
                                local color = entry.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                                if label.TextColor3 ~= color then label.TextColor3 = color end
                            end
                        end
                        -- FIXED: Don't destroy name tag just because adornPart is nil
                        -- Keep the old one for a bit — it might just be loading
                    elseif entry.NameTag then
                        entry.NameTag:Destroy(); entry.NameTag = nil
                        entry.Label = nil; entry.AdornPart = nil
                    end
                end
            end
        end
    end
end

