---------------------------------------------------------------------------
local function unload()
	pcall(function() RunService:UnbindFromRenderStep("AX_AIM_STEP") end)
	for _, c in ipairs(CONNS) do pcall(function() c:Disconnect() end) end
	for _, slot in pairs(SLOTS) do freeSlot(slot) end
	for _, d in ipairs(ALL_DRAWS) do dfree(d) end
	if fovCircle then dfree(fovCircle) end
	pcall(function() gui:Destroy() end)
	CONNS = {}
	_G.AX_UNLOAD = nil
	local env = (type(getgenv) == "function" and getgenv()) or _G
	if env then env.AX = nil end
end

_G.AX_UNLOAD = unload
local env = (type(getgenv) == "function" and getgenv()) or _G
if env then env.AX = { config = CONFIG, unload = unload, aim = AIM } end

