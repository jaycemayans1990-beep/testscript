local okPanel, panelErr = pcall(buildPanel)
if not okPanel then log("panel build failed: %s", tostring(panelErr)) end

local connections = {}
local function track(conn)
	if conn then connections[#connections + 1] = conn end
	return conn
end

track(RunService.Heartbeat:Connect(function(dt)
	local ok, err = pcall(tick, dt)
	if not ok then log("tick error: %s", tostring(err)) end
end))

if LP then
	pcall(function()
		local idled = rawget(LP, "Idled")
		if idled then
			track(idled:Connect(function()
				if not CONFIG.system.antiafk then return end
				if VIM then
					pcall(function()
						VIM:CaptureController()
						VIM:ClickButton2(Vector2.new(0, 0))
					end)
				end
			end))
		end
	end)
end

scanDummies()
scanPrompts()
scanRemotes()
bindByName()
if refresh_ui then pcall(refresh_ui) end
if buildList then pcall(buildList) end

---------------------------------------------------------------------------
-- unload / export
---------------------------------------------------------------------------
local function unload()
	STATE.running = false
	CONFIG.train.enabled = false
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	connections = {}
	if gui then pcall(function() gui:Destroy() end) end
	local g = (type(getgenv) == "function" and getgenv()) or _G
	if g.GLX_MT then g.GLX_MT = nil end
	if g.GLX_MT_UNLOAD then g.GLX_MT_UNLOAD = nil end
	log("unloaded")
end

local API = {
	config  = CONFIG,
	state   = STATE,
	bind    = STATE.bind,
	scan    = scanRemotes,
	dummies = scanDummies,
	prompts = scanPrompts,
	probe   = probe,
	punch   = punchOnce,
	rebirth = castRebirth,
	claim   = castClaim,
	tick    = tick,
	dump    = dumpText,
	refresh = refresh_ui,
	unload  = unload,
}
genv.GLX_MT = API
genv.GLX_MT_UNLOAD = unload

