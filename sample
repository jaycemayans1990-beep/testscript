---------------------------------------------------------------------------
-- tiny helpers
---------------------------------------------------------------------------
local function dnew(kind)
	local ok, obj = pcall(Drawing.new, kind)
	if ok and obj then return obj end
	return nil
end

local function dset(obj, props)
	if not obj then return end
	pcall(function()
		for k, v in pairs(props) do obj[k] = v end
	end)
end

local ALL_DRAWS = {}
local function track(obj)
	if obj then table.insert(ALL_DRAWS, obj) end
	return obj
end

local function dfree(obj)
	if not obj then return end
	pcall(function() obj:Remove() end)
end

local function now() return os.clock() end

local HAS_DRAWING = Drawing ~= nil and Drawing.new ~= nil
if not HAS_DRAWING then
	warn("[AX] no Drawing API in this executor — ESP disabled, aimbot still active")
	CONFIG.esp.enabled = false
end

