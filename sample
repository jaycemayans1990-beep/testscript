local function clickAt(x, y)
	x, y = math.floor(tonumber(x) or 0), math.floor(tonumber(y) or 0)
	if VIM then
		local ok = pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true, game, 1) end)
		pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 1) end)
		if ok then return true end
	end
	if type(mouse1click) == "function" then
		if pcall(mouse1click) then return true end
	end
	if type(mouse1press) == "function" and type(mouse1release) == "function" then
		pcall(mouse1press); pcall(mouse1release)
		return true
	end
	return false
end

local function screenPos(worldPos)
	local cam = rawget(workspace, "CurrentCamera")
	if not cam or not worldPos then return nil end
	local ok, sp, onScreen = pcall(function() return cam:WorldToViewportPoint(worldPos) end)
	if not ok or not sp then return nil end
	if sp.Z ~= nil and sp.Z <= 0 then return nil end
	return sp.X, sp.Y, onScreen
end

local function faceCamera(worldPos)
	local cam = rawget(workspace, "CurrentCamera")
	if not cam or not worldPos then return false end
	local ok = pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, worldPos) end)
	return ok
end

local function warpTo(worldPos, distance)
	local root = rootPart()
	if not root or not worldPos then return false end
	local back = distance or CONFIG.train.warpRange
	local target = CFrame.new(worldPos.X, worldPos.Y + 3, worldPos.Z + back)
	local ok = pcall(function() root.CFrame = target end)
	if ok then
		STATE.counters.warps = STATE.counters.warps + 1
		return true
	end
	return false
end

local function activateTool()
	local char = LP and rawget(LP, "Character")
	if not char then return false end
	local tool = safe(function() return char:FindFirstChildOfClass("Tool") end)
	if not tool then return false end
	if safe(function() return tool:Activate() end) ~= nil then return true end
	pcall(function() tool:Activate() end)
	return true
end

---------------------------------------------------------------------------
-- prompts (rebirth / upgrade pads usually show up as ProximityPrompt)
---------------------------------------------------------------------------
local function scanPrompts()
	local list = {}
	local desc = safe(function() return workspace:GetDescendants() end) or {}
	for _, d in ipairs(desc) do
		if d.ClassName == "ProximityPrompt" then
			list[#list + 1] = {
				inst = d,
				name = tostring(d.Name),
				action = tostring(rawget(d, "ActionText") or ""),
				object = tostring(rawget(d, "ObjectText") or ""),
				score = (hit(d.Name, KW.rebirth) and 3 or 0) + (hit(rawget(d, "ActionText") or "", KW.rebirth) and 2 or 0),
			}
		end
	end
	table.sort(list, function(a, b)
		if a.score ~= b.score then return a.score > b.score end
		return a.name < b.name
	end)
	STATE.prompts = list
	return list
end

local function firePrompt(entry)
	local p = entry and entry.inst
	if not p then return false end
	local hold = tonumber(rawget(p, "HoldDuration")) or 0
	pcall(function() p:InputHoldBegin() end)
	local function release()
		pcall(function() p:InputHoldEnd() end)
		pcall(function() p:InputHoldEnd() end)
	end
	if hold > 0.05 then
		task.delay(hold + 0.08, release)
	else
		release()
	end
	return true
end

---------------------------------------------------------------------------
-- remotes — scan, classify, then prove by stat delta
---------------------------------------------------------------------------
local function classify(name)
	if hit(name, KW.rebirth) then return "rebirth", 5 end
	if hit(name, KW.claim) then return "claim", 4 end
	if hit(name, KW.buy) then return "buy", 3 end
	if hit(name, KW.train) then return "train", 2 end
	return "unknown", 0
end

local function scanRemotes()
	local found = {}
	local seen = {}
	local function walk(root)
		if not root then return end
		local list = safe(function() return root:GetDescendants() end) or {}
		for _, d in ipairs(list) do
			local cn = d.ClassName
			if (cn == "RemoteEvent" or cn == "UnreliableRemoteEvent" or cn == "RemoteFunction") and not seen[d] then
				seen[d] = true
				local path = tostring(safe(function() return d:GetFullName() end) or d.Name)
				local kind, score = classify(d.Name .. " " .. path)
				found[#found + 1] = {
					inst = d, name = tostring(d.Name), path = path,
					kind = cn, group = kind, score = score,
					result = nil, delta = 0,
				}
			end
		end
	end
	walk(RS)
	walk(workspace)
	table.sort(found, function(a, b)
		if a.score ~= b.score then return a.score > b.score end
		return a.path < b.path
	end)
	STATE.remotes = found
	log("scanned %d remotes, %d prompts, %d dummies", #found, #scanPrompts(), #STATE.dummies)

	-- name-based binding: the best keyword match per class, before any proving
	for _, e in ipairs(found) do
		if e.group ~= "unknown" and STATE.bind[e.group] == nil then
			STATE.bind[e.group] = e
		end
	end
	return found
end

local function argSets(entry)
	local sets = { {} }
	local d = STATE.dummy and STATE.dummy.inst or nil
	if d then
		sets[#sets + 1] = { d }
		sets[#sets + 1] = { d.Name }
	end
	if LP then sets[#sets + 1] = { LP } end
	if d then sets[#sets + 1] = { d, 1 } end
	return sets
end

-- Fire one candidate across argument shapes, measure which shape moves a stat.
local function probe(entry, onDone)
	if not entry or not entry.inst then return end
	local inst = entry.inst
	local sets = argSets(entry)
	local before = collectStats()
	local beforeTotal = statTotal(before)
	local i = 0
	local best = { delta = 0, label = "no change", args = nil }

	local function record(delta, label, args)
		if math.abs(delta) > math.abs(best.delta) then
			best = { delta = delta, label = label, args = args }
		end
	end

	local function finish()
		entry.delta = best.delta
		entry.args = best.args
		entry.result = best.label
		if best.delta ~= 0 then
			entry.score = entry.score + 10
			if STATE.bind[entry.group] == nil and entry.group ~= "unknown" then
				STATE.bind[entry.group] = entry
			end
		end
		if onDone then onDone(entry, best) end
	end

	local function step()
		i = i + 1
		local args = sets[i]
		if not args then finish() return end
		pcall(function()
			if entry.kind == "RemoteFunction" then
				inst:InvokeServer(unpack_(args))
			else
				inst:FireServer(unpack_(args))
			end
		end)
		task.wait(0.22)
		local after = collectStats()
		local delta = statTotal(after) - beforeTotal
		if delta ~= 0 then
			local lines = statDiff(before, after)
			record(delta, table.concat(lines, " ") .. "  [" .. tostring(#args) .. " arg]", args)
			before = after
			beforeTotal = statTotal(after)
		end
		step()
	end
	step()
end

local function bindByName()
	for _, e in ipairs(STATE.remotes) do
		if e.group ~= "unknown" then
			local cur = STATE.bind[e.group]
			if cur == nil or (e.score or 0) > (cur.score or 0) then
				STATE.bind[e.group] = e
			end
		end
	end
end

local function dumpText()
	local out = {}
	out[#out + 1] = "place 133081981709881  player " .. tostring(LP and LP.Name)
	out[#out + 1] = string.format("remotes=%d prompts=%d dummies=%d", #STATE.remotes, #STATE.prompts, #STATE.dummies)
	out[#out + 1] = "--- remotes ---"
	for i, e in ipairs(STATE.remotes) do
		if i > 80 then break end
		out[#out + 1] = string.format("[%s] %s  (%s) %s%s", e.group, e.path, e.kind,
			e.result and ("=> " .. e.result) or "", e.args and "" or "")
	end
	out[#out + 1] = "--- prompts ---"
	for _, p in ipairs(STATE.prompts) do
		out[#out + 1] = string.format("%s  action=%q object=%q", p.name, p.action, p.object)
	end
	out[#out + 1] = "--- stats ---"
	local keys = {}
	for k in pairs(STATE.stats) do keys[#keys + 1] = k end
	table.sort(keys)
	for _, k in ipairs(keys) do out[#out + 1] = string.format("%s = %s", k, tostring(STATE.stats[k])) end
	return table.concat(out, "\n")
end

---------------------------------------------------------------------------
-- the punch
---------------------------------------------------------------------------
local function punchOnce()
	local d = refreshDummy(false)
	local clicked = false
	if d then
		if CONFIG.train.warp and (STATE.dummyDist or 0) > CONFIG.train.warpRange then
			warpTo(d.pos)
		end
		if CONFIG.train.face then faceCamera(d.pos) end
		local x, y = screenPos(d.pos)
		if x and y then clicked = clickAt(x, y) end
	end
	if CONFIG.train.useTool then activateTool() end
	if not clicked then
		local e = STATE.bind.train
		if e and e.inst then
			pcall(function() e.inst:FireServer() end)
			clicked = true
		end
	end
	if clicked then STATE.counters.clicks = STATE.counters.clicks + 1 end
	return clicked, d
end

local function castRebirth()
	local fired = false
	local e = STATE.bind.rebirth
	if e and e.inst then
		pcall(function()
			if e.kind == "RemoteFunction" then e.inst:InvokeServer() else e.inst:FireServer() end
		end)
		fired = true
	end
	for _, p in ipairs(STATE.prompts) do
		if (p.score or 0) > 0 then
			firePrompt(p)
			fired = true
			break
		end
	end
	if fired then STATE.counters.rebirths = STATE.counters.rebirths + 1 end
	return fired
end

local function castClaim()
	local fired = false
	for _, e in ipairs(STATE.remotes) do
		if e.group == "claim" and e.inst then
			pcall(function()
				if e.kind == "RemoteFunction" then e.inst:InvokeServer() else e.inst:FireServer() end
			end)
			fired = true
		end
	end
	if fired then STATE.counters.claims = STATE.counters.claims + 1 end
	return fired
end

---------------------------------------------------------------------------
-- heartbeat tick — one connection drives everything, no thread storms
---------------------------------------------------------------------------
local function tick(dt)
	if not STATE.running then return end
	dt = tonumber(dt) or (1 / 60)

	STATE.timers.stats = STATE.timers.stats + dt
	if STATE.timers.stats >= 0.5 then
		STATE.timers.stats = 0
		STATE.stats = collectStats()
	end

	if CONFIG.train.enabled then
		STATE.acc = STATE.acc + dt * math.max(1, math.min(40, CONFIG.train.cps))
		local guard = 0
		while STATE.acc >= 1 - 1e-6 and guard < 8 do
			STATE.acc = math.max(0, STATE.acc - 1)
			guard = guard + 1
			local ok = pcall(punchOnce)
			if not ok then break end
		end
	else
		STATE.acc = 0
	end

	if CONFIG.economy.rebirth then
		STATE.timers.rebirth = STATE.timers.rebirth + dt
		if STATE.timers.rebirth >= CONFIG.economy.rebirthEvery then
			STATE.timers.rebirth = 0
			local f = furyStat()
			if f == nil then f = statTotal(STATE.stats) end
			if f and f >= CONFIG.economy.rebirthMin then pcall(castRebirth) end
		end
	end

	if CONFIG.economy.claim then
		STATE.timers.claim = STATE.timers.claim + dt
		if STATE.timers.claim >= CONFIG.economy.claimEvery then
			STATE.timers.claim = 0
			pcall(castClaim)
		end
	end

	if CONFIG.system.antiafk then
		STATE.timers.afk = STATE.timers.afk + dt
		if STATE.timers.afk >= CONFIG.system.afkEvery then
			STATE.timers.afk = 0
			if VIM then pcall(function() VIM:SendMouseMoveEvent(0, 0, 0) end) end
			local hum = humanoid()
			if hum then pcall(function() hum.Jump = true end) end
		end
	end
end

