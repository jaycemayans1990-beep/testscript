-- 7. ADVANCED PREDICTION ENGINE (optimized)
-- ==========================================
-- FIXED: Use weak-value metatable for automatic cleanup — no polling task needed
local TargetStates = setmetatable({}, { __mode = "k" })
local MAX_SAMPLE_DT = 0.1; local MAX_PREDICTION_TIME = 5.0
local MAX_DV_PER_SAMPLE = 35; local SPIKE_COOLDOWN = 0.15; local MAX_ACCEL = 200
local ACCEL_TAU_BASE = 0.10; local MAX_ACCEL_LEAD = 12; local VEL_TAU = 0.05
local VELOCITY_SANITY = 3000

local function clampAccelLead(v3, cap)
    local m = v3.Magnitude
    if m > cap then return v3 * (cap/m) end
    return v3
end

CleanupManager:AddCustomCleanup(function() table.clear(TargetStates) end)

local function getKinematicPart(targetPart)
    local parent = targetPart.Parent
    if parent then
        local root = parent:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then return root end
    end
    return targetPart
end

local function getTargetAcceleration(kinPart, targetVel, currentTime)
    local state = TargetStates[kinPart]
    local velSane = isFiniteVec3(targetVel) and targetVel.Magnitude <= VELOCITY_SANITY
    
    if not velSane then
        if state then
            state.lastVelocity = isFiniteVec3(state.lastVelocity) and state.lastVelocity or Vector3.zero
            state.lastTime = currentTime
            state.smoothedAcceleration = Vector3.zero
            state.spikeUntil = currentTime + SPIKE_COOLDOWN
            state.lastPredictionTime = nil
            if not isFiniteVec3(state.smoothedVelocity) then state.smoothedVelocity = Vector3.zero end
        end
        local outVel = state and state.smoothedVelocity
        return Vector3.zero, (isFiniteVec3(outVel) and outVel) or Vector3.zero
    end
    
    if state then
        if not isFiniteVec3(state.smoothedVelocity) then state.smoothedVelocity = targetVel end
        if not isFiniteVec3(state.smoothedAcceleration) then state.smoothedAcceleration = Vector3.zero end
    end
    
    if not state then
        TargetStates[kinPart] = {
            lastVelocity = targetVel, lastTime = currentTime,
            smoothedAcceleration = Vector3.zero, smoothedVelocity = targetVel,
            lastPredictionTime = nil, spikeUntil = 0
        }
        return Vector3.zero, targetVel
    end
    
    local previousVelocity = state.lastVelocity
    local previousTime = state.lastTime
    local dt = currentTime - previousTime
    
    if dt <= 0 then
        return state.smoothedAcceleration or Vector3.zero, state.smoothedVelocity or targetVel
    end
    
    if dt > MAX_SAMPLE_DT then
        state.lastVelocity = targetVel; state.lastTime = currentTime
        state.smoothedAcceleration = Vector3.zero
        state.smoothedVelocity = targetVel
        state.lastPredictionTime = nil; state.spikeUntil = 0
        return Vector3.zero, targetVel
    end
    
    state.lastVelocity = targetVel; state.lastTime = currentTime
    local velAlpha = 1 - math.exp(-dt / VEL_TAU)
    
    if currentTime < state.spikeUntil then
        state.smoothedAcceleration = Vector3.zero
        state.smoothedVelocity = state.smoothedVelocity:Lerp(targetVel, velAlpha)
        return Vector3.zero, state.smoothedVelocity
    end
    
    local dv = targetVel - previousVelocity
    if dv.Magnitude > MAX_DV_PER_SAMPLE then
        state.spikeUntil = currentTime + SPIKE_COOLDOWN
        state.smoothedAcceleration = Vector3.zero
        state.smoothedVelocity = state.smoothedVelocity:Lerp(targetVel, velAlpha)
        return Vector3.zero, state.smoothedVelocity
    end
    
    local rawAcceleration = dv / dt
    state.smoothedVelocity = state.smoothedVelocity:Lerp(targetVel, velAlpha)
    
    local tau = ACCEL_TAU_BASE / math.clamp(State.PredReactivity or 1.0, 0.2, 3)
    local alpha = 1 - math.exp(-dt / tau)
    state.smoothedAcceleration = state.smoothedAcceleration:Lerp(rawAcceleration, alpha)
    
    local accelMag = state.smoothedAcceleration.Magnitude
    if accelMag > MAX_ACCEL then
        state.smoothedAcceleration = state.smoothedAcceleration * (MAX_ACCEL / accelMag)
    end
    
    return state.smoothedAcceleration, state.smoothedVelocity
end

-- OPTIMIZED: Secant iteration count adapts to distance (fewer iterations for close targets)
local function solveInterceptVector(shooterPos, targetPart, bulletSpeed, bulletGravityVec, deltaTime, leadTime, zoomScale)
    if typeof(bulletSpeed) ~= "number" or bulletSpeed <= 0 then return nil end
    if typeof(shooterPos) ~= "Vector3" then return nil end
    if typeof(bulletGravityVec) ~= "Vector3" then return nil end
    if not targetPart or not targetPart:IsA("BasePart") then return nil end
    
    local dt = deltaTime or (1/60)
    local currentTime = os.clock()
    local targetPos = targetPart.Position
    local kinPart = getKinematicPart(targetPart)
    local targetAcc, targetVel = getTargetAcceleration(kinPart, kinPart.AssemblyLinearVelocity, currentTime)
    local pingOffset = (State.PingCompensation and (getPing()*0.5) or 0) + (leadTime or 0)
    local accelLeadCap = MAX_ACCEL_LEAD / (zoomScale or getZoomScale(getCamera()))
    
    local function f(t)
        local totalT = t + pingOffset
        local targetAtT = targetPos + (targetVel*totalT) + clampAccelLead(0.5*targetAcc*(totalT^2), accelLeadCap)
        local bulletDropAtT = 0.5*bulletGravityVec*(t^2)
        local requiredDisplacement = targetAtT - shooterPos - bulletDropAtT
        return (bulletSpeed*t) - requiredDisplacement.Magnitude
    end
    
    local initialDist = (targetPos - shooterPos).Magnitude
    local t0 = 0
    local t1 = (initialDist/bulletSpeed) + pingOffset
    if t1 <= 0 then return safeUnit(targetPos - shooterPos) end
    
    local f0 = f(t0); local f1 = f(t1)
    local t_intercept = t1; local tolerance = 0.001
    
    -- Adaptive iterations: more for long-range, fewer for close-range
    local maxIter = (initialDist > 500) and 8 or ((initialDist > 200) and 5 or 3)
    
    for _ = 1, maxIter do
        if math.abs(f1 - f0) < 1e-6 then break end
        local next_t = t1 - f1*(t1-t0)/(f1-f0)
        if next_t ~= next_t or next_t == math.huge or next_t == -math.huge then
            t_intercept = t1; break
        end
        t_intercept = math.clamp(next_t, 0, MAX_PREDICTION_TIME)
        if math.abs(t_intercept - t1) < tolerance then break end
        t0, f0 = t1, f1; t1 = t_intercept; f1 = f(t1)
    end
    
    local state = TargetStates[kinPart]
    if state then
        local prevPredictionTime = state.lastPredictionTime
        if prevPredictionTime then
            local maxDelta = (State.PredMaxSlew or 3.0) * dt
            t_intercept = prevPredictionTime + math.clamp(t_intercept - prevPredictionTime, -maxDelta, maxDelta)
        end
        state.lastPredictionTime = t_intercept
    end
    
    local finalT = t_intercept + pingOffset
    local finalTargetPos = targetPos + (targetVel*finalT) + clampAccelLead(0.5*targetAcc*(finalT^2), accelLeadCap)
    local displacement = finalTargetPos - shooterPos
    
    if t_intercept > 0 then
        local requiredVelocity = (displacement/t_intercept) - (0.5*bulletGravityVec*t_intercept)
        local finalUnit = safeUnit(requiredVelocity)
        if finalUnit then return finalUnit end
    end
    
    return safeUnit(displacement)
end

local lastGravVal, lastGravVec = nil, nil
local predFallbackStreak = 0

local function getPredictedPosition(targetPart, shooterPos, deltaTime, leadTime, zoomScale)
    local targetPos = targetPart.Position
    
    if not State.Prediction then
        lastGravVal, lastGravVec = nil, nil
        if leadTime and leadTime > 0 then
            local kinPart = getKinematicPart(targetPart)
            if kinPart then
                local _, vel = getTargetAcceleration(kinPart, kinPart.AssemblyLinearVelocity, os.clock())
                if vel and vel.Magnitude > 1e-3 and vel.Magnitude <= VELOCITY_SANITY then
                    targetPos += vel * leadTime
                end
            end
        end
        return targetPos
    end
    
    if lastGravVal ~= WeaponService.Gravity then
        lastGravVal = WeaponService.Gravity
        lastGravVec = Vector3.new(0, -lastGravVal, 0)
    end
    
    local bulletSpeed = math.max(WeaponService.Speed, 1)
    local aimDirection = solveInterceptVector(shooterPos, targetPart, bulletSpeed, lastGravVec, deltaTime, leadTime, zoomScale)
    
    if aimDirection then
        predFallbackStreak = 0
        return shooterPos + (aimDirection*10000)
    end
    
    predFallbackStreak += 1
    if predFallbackStreak % 60 == 1 then
        setGlxStatus("pred fallback #"..predFallbackStreak.." spd="..math.floor(bulletSpeed))
    end
    return targetPos
end

