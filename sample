local function renderTick()
    frameN += 1
    local camera = getCamera()
    if not camera then return end
    
    -- FOV circle
    local vp = camera.ViewportSize
    local screenCX, screenCY = vp.X*0.5, vp.Y*0.5
    local scaledFOV = State.FOV*(vp.Y/1080)
    
    if State.ShowFOV then
        FOVCircle.Position = Vector2.new(screenCX, screenCY)
        FOVCircle.Radius = scaledFOV
        FOVCircle.Visible = true
    elseif FOVCircle.Visible then
        FOVCircle.Visible = false
    end
    
    -- Check toggle every 60 frames
    if frameN % 60 == 0 then
        State.Aimbot = readAimbotToggle()
    end
    
    if not State.Aimbot then return end
    if not hasActiveWeapon() then return end
    
    local myChar = LocalPlayer.Character
    if not myChar then return end
    
    -- Find best target in FOV
    local best, bestDist = nil, scaledFOV
    local players = Players:GetPlayers()
    
    for i = 1, #players do
        local player = players[i]
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        if char:FindFirstChildOfClass("ForceField") then continue end
        
        -- Team check
        if State.TeamCheck then
            if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end
        end
        
        -- Target part
        local part = nil
        if State.TargetPartMode == "Head" then
            part = char:FindFirstChild("Head")
        elseif State.TargetPartMode == "Torso" then
            part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
        end
        if not part then part = char:FindFirstChild("HumanoidRootPart") end
        if not part then continue end
        
        local sp, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen or sp.Z <= 0 then continue end
        
        local dx = sp.X - screenCX
        local dy = sp.Y - screenCY
        local d = math.sqrt(dx*dx + dy*dy)
        if d >= bestDist then continue end
        
        -- Wall check
        if State.WallCheck and not VisibilityService:CheckVisibility(char, 2, nil) then continue end
        
        bestDist = d
        best = part
    end
    
    if not best then return end
    
    -- Compute aim direction
    local shooterPos = camera.CFrame.Position
    local targetPos = best.Position
    
    if State.Prediction then
        targetPos = getPredictedPosition(best, shooterPos, 1/60, 0, getZoomScale(camera))
    end
    
    local dir = safeUnit(targetPos - shooterPos)
    if not dir then return end
    
    local dot = camera.CFrame.LookVector:Dot(dir)
    if dot > 0.9995 then return end -- already on target
    
    -- Smooth interpolation
    local zoomScale = getZoomScale(camera)
    local baseRate = (10 + State.Smoothness*30) * zoomScale
    local effSpeed = math.min(baseRate + math.deg(math.acos(math.clamp(dot,-1,1)))*zoomScale*(State.TrackBoost or 1.5), 70)
    local alpha = math.clamp(1 - math.exp(-effSpeed * math.min(1/60, 1/30)), 0, 1)
    
    local smooth = safeUnit(camera.CFrame.LookVector:Lerp(dir, alpha))
    if smooth then
        local ok, newCF = pcall(CFrame.lookAt, shooterPos, shooterPos + smooth)
        if ok and newCF then camera.CFrame = newCF end
    end
end

