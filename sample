local function hasActiveWeapon()
    local character = LocalPlayer and LocalPlayer.Character
    if not character then return false end
    if State.WeaponCheck == false then return true end
    return character:FindFirstChildOfClass("Tool") ~= nil
end

print("[GLX v3.17] Main loop starting...")

local flickUntil = 0; local flickArmStart = nil
local FLICK_ARM = 0.06; local prevReadLook = nil; local lastWriteLook = nil
local FLICK_HOLD = 0.10; local STEER_DPS = 30; local STEER_HOLD = 0.22
local STEER_MIN_INFLUENCE = 0.15; local STEER_TAU = 0.07
local steerInfluence = 1; local steerHoldStart = nil
local prevErrDeg = nil; local lastRenderTick = os.clock()
local renderErrStreak = 0
-- v3.17.1: ตัวแปรกรองสัญญาณ (แก้กล้องสั่นตอนซูม)
local aimDirSmoothed = nil   -- EMA ของทิศทางเล็ง (กรอง noise จาก prediction)
local errTrend = 0           -- EMA ของอัตราการเปลี่ยน error (deg/frame) ใช้ตัดสิน steering
local steerActive = false    -- hysteresis flag กัน steerInfluence แกว่งทุกเฟรม

-- OPTIMIZED: Cache viewport center and FOV calculations per frame
local function renderTick(deltaTime)
    local camera = getCamera()
    if not camera then return end
    
    local aiming = State.Aimbot and hasActiveWeapon()
    local userDps = 0
    
    if not aiming then
        prevReadLook = camera.CFrame.LookVector
        lastWriteLook = nil
        if TargetService.CurrentTarget then TargetService:ReleaseTarget() end
        prevErrDeg = nil; steerInfluence = 1
        steerHoldStart = nil; flickArmStart = nil
        aimDirSmoothed = nil; errTrend = 0; steerActive = false
    end
    
    if aiming then
        local userLook = camera.CFrame.LookVector
        local dtSafe = math.max(deltaTime, 1e-4)
        userDps = math.huge
        
        if prevReadLook then
            local uDot = math.clamp(userLook:Dot(prevReadLook), -1, 1)
            local uDeg = math.deg(math.acos(uDot))
            if uDeg > 0.05 then userDps = uDeg/dtSafe end
        end
        
        if lastWriteLook then
            local wDot = math.clamp(userLook:Dot(lastWriteLook), -1, 1)
            local wDeg = math.deg(math.acos(wDot))
            local againstPull = false
            if prevReadLook then
                local pullAxis = prevReadLook:Cross(lastWriteLook)
                local handAxis = lastWriteLook:Cross(userLook)
                againstPull = pullAxis:Dot(handAxis) < 0
            end
            if againstPull or wDeg/dtSafe < userDps then userDps = wDeg/dtSafe end
        end
        
        if userDps == math.huge then userDps = 0 end
        prevReadLook = userLook; lastWriteLook = nil
    end
    
    local nowClock = os.clock()
    
    -- Flick detection
    -- FIXED v3.17.1: ตอนซูม (FOV แคบ) camera CFrame ที่ script เขียนเองถูกอ่านเป็น "มือผู้เล่น"
    -- → flick trigger ทุก ~0.16s → ปล่อยเป้า/รับใหม่ → กล้องกระตุกเป็นจังหวะ
    -- แก้: ยก threshold ตามระดับ zoom (ซูม 5x = ต้อง flick แรงขึ้น 5 เท่าจึงจะปล่อยเป้า)
    local flickThreshold = (State.FlickSpeed or 90) * (zoomSmoothed and math.max(zoomSmoothed, 1) or 1)
    if State.DragSwitch and userDps > flickThreshold then
        if not flickArmStart then flickArmStart = nowClock end
        if nowClock - flickArmStart >= FLICK_ARM then
            flickUntil = nowClock + FLICK_HOLD
        end
    else
        flickArmStart = nil
    end
    
    -- Zoom smoothing
    if aiming then
        local zoomRaw = getZoomScale(camera)
        if not zoomSmoothed then zoomSmoothed = zoomRaw
        else
            zoomSmoothed += (zoomRaw - zoomSmoothed)*(1 - math.exp(-deltaTime/ZOOM_TAU))
        end
    else
        zoomSmoothed = nil
    end
    
    local vp = camera.ViewportSize
    local screenCX, screenCY = vp.X*0.5, vp.Y*0.5
    local scaledFOV = State.FOV*(vp.Y/1080)
    
    -- FOV circle
    if State.ShowFOV then
        local pos = FOVCircle.Position
        if pos.X ~= screenCX or pos.Y ~= screenCY then
            FOVCircle.Position = Vector2.new(screenCX, screenCY)
        end
        if FOVCircle.Radius ~= scaledFOV then
            FOVCircle.Radius = scaledFOV
        end
        if not FOVCircle.Visible then FOVCircle.Visible = true end
    elseif FOVCircle.Visible then
        FOVCircle.Visible = false
    end
    
    if not aiming then return end
    
    -- Flick hold — release target
    if State.DragSwitch and nowClock < flickUntil then
        if TargetService.CurrentTarget then
            switchAwayKey = TargetService.CurrentTarget
            switchCooldownUntil = nowClock + SWITCH_COOLDOWN
            TargetService:ReleaseTarget()
        end
        steerInfluence = 1; steerHoldStart = nil; prevErrDeg = nil
        return
    end
    
    if switchAwayKey and nowClock >= switchCooldownUntil then
        switchAwayKey = nil
    end
    
    -- Keep or release current target
    if TargetService.CurrentTarget then
        if not isValidEnemy(TargetService.CurrentTarget) then
            TargetService:ReleaseTarget()
        else
            local keep, offScreen = TargetService:KeepTarget(camera, screenCX, screenCY, scaledFOV)
            if keep then
                targetGraceUntil = 0
            else
                if targetGraceUntil == 0 and not offScreen then
                    targetGraceUntil = nowClock + TARGET_GRACE
                end
                if offScreen or nowClock >= targetGraceUntil then
                    TargetService:ReleaseTarget()
                end
            end
        end
    end
    
    -- Acquire new target
    if not TargetService.CurrentTarget and nowClock - lastAcquireAt >= ACQUIRE_INTERVAL then
        lastAcquireAt = nowClock
        TargetService:AcquireTarget(camera, screenCX, screenCY, scaledFOV)
    end
    
    -- Switch assist
    if State.SwitchAssist and TargetService.CurrentTarget then
        TargetService:CheckSwitch(camera, screenCX, screenCY, scaledFOV)
    end
    
    -- Aim at target
    local targetPart = TargetService.TargetPart
    if TargetService.CurrentTarget and targetPart and targetPart.Parent then
        local shooterPos = camera.CFrame.Position
        local zoomScale = zoomSmoothed or 1
        
        -- ===== v3.17.1: zoom-stable aim controller =====
        -- บั๊กเดิม: baseRate ถูกคูณ zoomScale → ที่ 5x alpha/เฟรม = 0.69
        --           noise ของ prediction ทะลุเข้า camera เกือบ 100% → กล้องสั่น
        -- แก้: ควบคุมเป็น "pixel error บนจอ" + deadband + EMA + hysteresis
        local sdt = math.min(deltaTime, 1/30)

        -- px ต่อ 1 องศา ที่ FOV ปัจจุบัน (ซูมยิ่งมาก ตัวคูณยิ่งสูง)
        local fovDeg = math.clamp(camera.FieldOfView, 1, 120)
        local pxPerDeg = (vp.Y * 0.5) / math.max(math.tan(math.rad(fovDeg) * 0.5), 1e-3) * (math.pi / 180)
        local zoomNow = math.clamp(DEFAULT_FOV / math.max(fovDeg, 1), 1, 12)  -- ใช้ค่าจริง ไม่ clamp 5
        local scoped = zoomNow > 2

        local speedBase = 12 + State.Smoothness*38   -- อัตราคอนเวิร์จ (px-space ไม่ผูกกับ zoom)
        local leadTau = State.LagComp and math.min(1/math.max(speedBase, 1), 0.15) or 0

        local targetPos = getPredictedPosition(targetPart, shooterPos, deltaTime, leadTau, zoomScale)
        local desiredDirection = safeUnit(targetPos - shooterPos)

        if desiredDirection then
            -- EMA กรองทิศทาง: ตัด noise จาก AssemblyLinearVelocity + accel lead
            -- tau ยาวขึ้นตาม zoom (ซูมสูง = ต้องนิ่งกว่า)
            local dirTau = 0.030 + 0.018*zoomNow
            if not aimDirSmoothed then
                aimDirSmoothed = desiredDirection
            else
                local k = 1 - math.exp(-sdt/dirTau)
                local blended = safeUnit(aimDirSmoothed:Lerp(desiredDirection, k))
                if blended then aimDirSmoothed = blended end
            end
            local aimDir = aimDirSmoothed

            local dot = math.clamp(camera.CFrame.LookVector:Dot(aimDir), -1, 1)
            local errDeg = math.deg(math.acos(dot))
            -- error ใหญ่ (เพิ่งสลับเป้า/หลัง flick) → ลัดทันที ไม่ต้องรอ EMA ให้หนืด
            if errDeg > 25 then aimDirSmoothed = aimDir end
            local pxErr = errDeg * pxPerDeg

            -- deadband: noise ใต้ ~1.5px ไม่เขียนกล้อง (กันสั่นตอนล็อคแล้ว)
            local deadbandPx = 1.0 + 0.6*(State.Smoothness or 0.8)

            -- trend ของ error (EMA) — แทนการเทียบ errDeg กับ prevErrDeg ตรง ๆ ที่ toggle ทุกเฟรม
            local errDelta = errDeg - (prevErrDeg or errDeg)
            errTrend += (errDelta - errTrend) * (1 - math.exp(-sdt/0.10))

            -- steering: มี hysteresis + ปิดตอนซูม (ซูมแล้วปล่อยเป้า = ภาพกระตุกหนัก)
            local steerWanted = State.FreeSteer and not scoped and userDps > STEER_DPS
                and errTrend > 0.30 and errDeg > 1.0
            if steerActive then
                if not (State.FreeSteer and not scoped and userDps > STEER_DPS and errTrend > 0.08) then
                    steerActive = false
                end
            elseif steerWanted then
                steerActive = true
            end
            local steering = steerActive

            if steering then
                if not steerHoldStart then steerHoldStart = nowClock end
                if State.DragSwitch and nowClock - steerHoldStart >= STEER_HOLD then
                    switchAwayKey = TargetService.CurrentTarget
                    switchCooldownUntil = nowClock + SWITCH_COOLDOWN
                    TargetService:ReleaseTarget()
                    flickUntil = nowClock + FLICK_HOLD
                    aimDirSmoothed = nil; errTrend = 0; steerActive = false
                    return
                end
            else
                steerHoldStart = nil
            end

            local infTarget = steering and STEER_MIN_INFLUENCE or 1
            steerInfluence += (infTarget - steerInfluence)*(1 - math.exp(-deltaTime/STEER_TAU))
            steerInfluence = math.clamp(steerInfluence, 0, 1)

            -- คุมความเร็วกล้องเป็น pixel/เฟรม → ที่ zoom เท่าไรก็ไม่ overshoot
            if pxErr > deadbandPx then
                local alphaBase = 1 - math.exp(-speedBase*sdt)
                local maxStepPx = (26 + State.Smoothness*34) * (1 + (State.TrackBoost or 1.5)*0.25)
                local stepPx = math.min(pxErr*alphaBase, maxStepPx) * steerInfluence
                local alpha = math.clamp(stepPx / math.max(pxErr, 1e-6), 0, 1)

                local smoothDirection = safeUnit(camera.CFrame.LookVector:Lerp(aimDir, alpha))
                if smoothDirection then
                    local ok, newCFrame = pcall(CFrame.lookAt, shooterPos, shooterPos + smoothDirection)
                    if ok and newCFrame then
                        camera.CFrame = newCFrame
                        lastWriteLook = smoothDirection
                    end
                end
            end
            prevErrDeg = errDeg
        else
            prevErrDeg = nil
        end
    end
end

local function connectRenderLoop()
    CleanupManager:AddConn("RenderStep", RunService.RenderStepped:Connect(function(deltaTime)
        lastRenderTick = os.clock()
        local ok, err = xpcall(renderTick, traceFn, deltaTime)
        if ok then renderErrStreak = 0
        else
            renderErrStreak += 1
            if renderErrStreak == 10 then
                warn("[GLX v3.17] aim loop error: "..tostring(err))
                if setStickyStatus then setStickyStatus("aim error: "..tostring(err):sub(1,40)) end
            end
        end
    end))
end
connectRenderLoop()

