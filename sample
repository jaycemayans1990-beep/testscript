local TARGET_GRACE = 0.25; local KEEP_HYSTERESIS = 1.35; local ZOOM_TAU = 0.08
local targetGraceUntil = 0; local zoomSmoothed = nil
local keepWallCheckUntil, keepWallVisible = 0, true
local SWITCH_COOLDOWN = 0.30; local switchAwayKey = nil; local switchCooldownUntil = 0
local SWITCH_RATIO = 0.50; local SWITCH_CHECK_INTERVAL = 0.05; local lastSwitchCheck = 0
local ACQUIRE_INTERVAL = 1 / 30; local lastAcquireAt = 0
local ACQUIRE_SKIP = 0 -- frame counter to skip expensive per-frame work

local TargetService = { CurrentTarget = nil, TargetPart = nil, LockedPartName = nil }
local RANDOM_PARTS = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" }

-- FIXED: Proper torso targeting using UpperTorso/LowerTorso
function TargetService:GetTargetPart(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if State.TargetPartMode == "Head" then
        return char:FindFirstChild("Head") or root
    end
    if State.TargetPartMode == "Torso" then
        -- Try UpperTorso first (chest hitbox), then LowerTorso, then root
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso") or root
    end
    if State.TargetPartMode == "Random" then
        if self.LockedPartName then
            local locked = char:FindFirstChild(self.LockedPartName)
            if locked then return locked end
        end
        local name = RANDOM_PARTS[math.random(1, #RANDOM_PARTS)]
        local picked = char:FindFirstChild(name)
        if not picked then picked = root; name = "HumanoidRootPart" end
        self.LockedPartName = name
        return picked
    end
    return root
end

function TargetService:ReleaseTarget()
    self.CurrentTarget = nil; self.TargetPart = nil; self.LockedPartName = nil
    targetGraceUntil = 0; keepWallCheckUntil = 0; keepWallVisible = true
end

function TargetService:KeepTarget(camera, screenX, screenY, scaledFOV)
    local target = self.CurrentTarget
    if not isValidEnemy(target) then return false, false end
    local part = self.TargetPart
    if not (part and part.Parent and part:IsDescendantOf(target.Character)) then return false, false end
    if State.WallCheck then
        local nowWC = os.clock()
        if nowWC >= (keepWallCheckUntil or 0) then
            keepWallCheckUntil = nowWC + (1/15)
            -- FIXED v3.18: Use character-level visibility (shared cache)
            keepWallVisible = VisibilityService:CheckVisibility(target.Character, 2, nil)
        end
        if not keepWallVisible then return false, false end
    end
    local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
    if not onScreen or screenPoint.Z <= 0 then return false, true end
    local dx = screenPoint.X - screenX; local dy = screenPoint.Y - screenY
    local keepRadius = scaledFOV * KEEP_HYSTERESIS
    return dx*dx + dy*dy <= keepRadius*keepRadius, false
end

-- OPTIMIZED: Acquire only every 3 frames to reduce player iteration cost
function TargetService:AcquireTarget(camera, screenX, screenY, scaledFOV)
    ACQUIRE_SKIP += 1
    if ACQUIRE_SKIP % 3 ~= 0 then return end -- every 3rd frame only
    
    local closestDistSq = scaledFOV * scaledFOV
    local banRadiusSq = (scaledFOV*0.12)*(scaledFOV*0.12)
    local closestPlayer, bestPart = nil, nil
    local now = os.clock()
    local cooldownActive = switchCooldownUntil > now and switchAwayKey ~= nil
    local players = Players:GetPlayers()
    
    for i = 1, #players do
        local player = players[i]
        if not isValidEnemy(player) then continue end
        local part = self:GetTargetPart(player.Character)
        if not part then continue end
        local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen or screenPoint.Z <= 0 then continue end
        local dx = screenPoint.X - screenX; local dy = screenPoint.Y - screenY
        local distSq = dx*dx + dy*dy
        if distSq >= closestDistSq then continue end
        local banned = cooldownActive and player == switchAwayKey
        if banned and distSq > banRadiusSq then continue end
        -- FIXED v3.18: Use character-level visibility (nil specificPart) → hits shared cache
        if State.WallCheck and not VisibilityService:CheckVisibility(player.Character, 2, nil) then continue end
        closestDistSq = distSq; closestPlayer = player; bestPart = part
    end
    
    if closestPlayer then
        if closestPlayer ~= self.CurrentTarget then self.LockedPartName = nil end
        self.CurrentTarget = closestPlayer; self.TargetPart = bestPart
    end
end

function TargetService:CheckSwitch(camera, screenX, screenY, scaledFOV)
    local now = os.clock()
    if now - lastSwitchCheck < SWITCH_CHECK_INTERVAL then return end
    lastSwitchCheck = now
    
    local target = self.CurrentTarget
    local part = self.TargetPart
    if not (target and part and part.Parent) then return end
    
    local myPoint, myOn = camera:WorldToViewportPoint(part.Position)
    if not (myOn and myPoint.Z > 0) then return end
    local myDx, myDy = myPoint.X - screenX, myPoint.Y - screenY
    local myDistSq = myDx*myDx + myDy*myDy
    local limitSq = math.min(myDistSq * (SWITCH_RATIO*SWITCH_RATIO), scaledFOV*scaledFOV)
    if limitSq <= 0 then return end
    
    local cooldownActive = switchCooldownUntil > now and switchAwayKey ~= nil
    local banRadiusSq = (scaledFOV*0.12)*(scaledFOV*0.12)
    local bestDistSq = limitSq; local bestPlayer, bestPart = nil, nil
    local players = Players:GetPlayers()
    
    for i = 1, #players do
        local player = players[i]
        if player == target then continue end
        if not isValidEnemy(player) then continue end
        local cand = self:GetTargetPart(player.Character)
        if not cand then continue end
        local sp, onScreen = camera:WorldToViewportPoint(cand.Position)
        if not onScreen or sp.Z <= 0 then continue end
        local dx = sp.X - screenX; local dy = sp.Y - screenY
        local distSq = dx*dx + dy*dy
        if distSq >= bestDistSq then continue end
        local banned = cooldownActive and player == switchAwayKey
        if banned and distSq > banRadiusSq then continue end
        bestDistSq = distSq; bestPlayer = player; bestPart = cand
    end
    
    if bestPlayer and (not State.WallCheck or VisibilityService:CheckVisibility(bestPlayer.Character, 2, nil)) then
        switchAwayKey = target; switchCooldownUntil = now + SWITCH_COOLDOWN
        self.CurrentTarget = bestPlayer; self.TargetPart = bestPart; self.LockedPartName = nil
        targetGraceUntil = 0; keepWallCheckUntil = 0; keepWallVisible = true
    end
end

