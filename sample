local function getComponents(player)
    local char = player.Character
    if not char then PlayerCache[player] = nil; return nil end
    local entry = PlayerCache[player]
    if not entry or entry.Character ~= char then
        entry = {
            Character = char,
            Humanoid = char:FindFirstChildOfClass("Humanoid"),
            Root = char:FindFirstChild("HumanoidRootPart"),
            Head = findPart(char, HEAD_NAMES),
            UpperTorso = findPart(char, TORSO_NAMES),
            LowerTorso = char:FindFirstChild("LowerTorso"),
            _lastFullScan = os.clock()
        }
        PlayerCache[player] = entry
    end
    -- Periodic re-scan for parts that might have loaded late (every 2s)
    if os.clock() - (entry._lastFullScan or 0) > 2 then
        if not entry.Head or entry.Head.Parent ~= char then entry.Head = findPart(char, HEAD_NAMES) end
        if not entry.UpperTorso or entry.UpperTorso.Parent ~= char then entry.UpperTorso = findPart(char, TORSO_NAMES) end
        entry._lastFullScan = os.clock()
    end
    -- Quick validation of existing refs
    if entry.Humanoid and entry.Humanoid.Parent ~= char then entry.Humanoid = char:FindFirstChildOfClass("Humanoid") end
    if entry.Root and entry.Root.Parent ~= char then entry.Root = char:FindFirstChild("HumanoidRootPart") end
    return entry
end

-- FIXED: isValidEnemy with result caching (avoids repeated calls)
local ValidityCache = setmetatable({}, { __mode = "k" })
local VALIDITY_TTL = 0.1 -- cache enemy validity for 100ms

local function isValidEnemy(player)
    if not player or player == LocalPlayer then return false end
    
    -- Quick cache check
    local vc = ValidityCache[player]
    local now = os.clock()
    if vc and now - vc.time < VALIDITY_TTL then return vc.valid end
    
    local entry = getComponents(player)
    if not entry then ValidityCache[player] = { valid = false, time = now }; return false end
    local humanoid, root = entry.Humanoid, entry.Root
    if not humanoid or humanoid.Health <= 0 then ValidityCache[player] = { valid = false, time = now }; return false end
    if not root or root.Parent ~= entry.Character then ValidityCache[player] = { valid = false, time = now }; return false end
    
    -- ForceField check with longer cache
    if now >= (entry.FFCheckUntil or 0) then
        entry.HasForceField = entry.Character:FindFirstChildOfClass("ForceField") ~= nil
        entry.FFCheckUntil = now + 0.5 -- up from 0.25
    end
    if entry.HasForceField then ValidityCache[player] = { valid = false, time = now }; return false end
    
    if State.TeamCheck then
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then ValidityCache[player] = { valid = false, time = now }; return false end
        if player.TeamColor and LocalPlayer.TeamColor and player.TeamColor == LocalPlayer.TeamColor then ValidityCache[player] = { valid = false, time = now }; return false end
    end
    
    ValidityCache[player] = { valid = true, time = now }
    return true
end

