---------------------------------------------------------------------------
-- utils
---------------------------------------------------------------------------
local function lower(s) return string.lower(tostring(s or "")) end
-- Lua patterns have no alternation: split on '|' and run literal finds
local function hit(name, pattern)
	if not name or not pattern then return false end
	local s = lower(name)
	for word in string.gmatch(pattern, "[^|]+") do
		if string.find(s, word, 1, true) then return true end
	end
	return false
end

local unpack_ = table.unpack or unpack

local function log(fmt, ...)
	local ok, line = pcall(string.format, fmt, ...)
	print("[GLX-MT] " .. (ok and line or tostring(fmt)))
end

local function safe(fn, ...)
	local ok, res = pcall(fn, ...)
	if ok then return res end
	return nil
end

local function statNumber(v)
	if type(v) == "number" then return v end
	if type(v) == "string" then
		local n = tonumber(v:gsub("[,%s]", ""))
		return n
	end
	return nil
end

-- position of any instance that could be a dummy/character
local function getPos(inst)
	if not inst then return nil end
	local p = safe(function() return inst:GetPivot().Position end)
	if p then return p end
	local prim = rawget(inst, "PrimaryPart")
	if prim and prim.Position then return prim.Position end
	local part = safe(function() return inst:FindFirstChildOfClass("BasePart") end)
	if not part then part = safe(function() return inst:FindFirstChild("HumanoidRootPart") end) end
	if not part then part = safe(function() return inst:FindFirstChildOfClass("Part") end) end
	if part and part.Position then return part.Position end
	local cf = safe(function() return inst:GetBoundingBox() end)
	if cf and cf.Position then return cf.Position end
	local pos = rawget(inst, "Position")
	if pos then return pos end
	return nil
end

local function dist(a, b)
	if not a or not b then return math.huge end
	local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function myPos()
	if not LP then return nil end
	local char = rawget(LP, "Character")
	if not char then return nil end
	local root = safe(function() return char:FindFirstChild("HumanoidRootPart") end)
	if root and root.Position then return root.Position end
	return getPos(char)
end

local function rootPart()
	local char = LP and rawget(LP, "Character")
	if not char then return nil end
	return safe(function() return char:FindFirstChild("HumanoidRootPart") end)
end

local function humanoid()
	local char = LP and rawget(LP, "Character")
	if not char then return nil end
	return safe(function() return char:FindFirstChildOfClass("Humanoid") end)
end

---------------------------------------------------------------------------
-- stats — every numeric value hanging off the player, diffed for proof
---------------------------------------------------------------------------
local function collectStats()
	local out = {}
	if not LP then return out end
	local function eat(inst, prefix, depth)
		if depth > 3 then return end
		local children = safe(function() return inst:GetChildren() end) or {}
		for _, child in ipairs(children) do
			local cn = child.ClassName
			if cn == "IntValue" or cn == "NumberValue" or cn == "StringValue" then
				out[prefix .. tostring(child.Name)] = rawget(child, "Value")
			elseif cn == "Folder" then
				eat(child, prefix .. tostring(child.Name) .. ".", depth + 1)
			end
		end
	end
	eat(LP, "", 0)
	return out
end

-- total of every numeric stat: one number that moves when anything pays out
local function statTotal(stats)
	local total = 0
	for _, v in pairs(stats or {}) do
		local n = statNumber(v)
		if n then total = total + n end
	end
	return total
end

local function statDiff(before, after)
	local lines = {}
	for k, v in pairs(after or {}) do
		local n = statNumber(v)
		local o = statNumber((before or {})[k])
		if n and (o == nil or n ~= o) then
			local d = n - (o or 0)
			local sign = d >= 0 and "+" or ""
			lines[#lines + 1] = string.format("%s %s%s", k, sign, tostring(math.floor(d * 100) / 100))
		end
	end
	table.sort(lines)
	return lines
end

local function furyStat()
	local best, bestKey = nil, nil
	local keys = {}
	for k, v in pairs(STATE.stats or {}) do keys[#keys + 1] = k end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local v = statNumber(STATE.stats[k])
		if v and hit(k, "fury|might|power|strength|point|force") then
			if not best or v > best then best, bestKey = v, k end
		end
	end
	return best, bestKey
end

---------------------------------------------------------------------------
-- dummy discovery
---------------------------------------------------------------------------
local function isPlayerCharacter(inst)
	for _, plr in ipairs(safe(function() return Players:GetPlayers() end) or {}) do
		if rawget(plr, "Character") == inst then return true end
	end
	return false
end

local function scanDummies()
	local list = {}
	local desc = safe(function() return workspace:GetDescendants() end) or {}
	local seen = {}
	for _, d in ipairs(desc) do
		local cn = d.ClassName
		local isModel = (cn == "Model")
		local isPart = (cn == "Part" or cn == "MeshPart" or cn == "UnionOperation" or cn == "BasePart")
		if (isModel or isPart) and hit(d.Name, CONFIG.train.nameFilter) and not isPlayerCharacter(d) then
			if not seen[d] then
				seen[d] = true
				local pos = getPos(d)
				if pos then
					list[#list + 1] = { inst = d, name = tostring(d.Name), pos = pos }
				end
			end
		end
	end

	-- fallback: any non-player humanoid model close by (dummies without a keyword name)
	if #list == 0 then
		for _, d in ipairs(desc) do
			if d.ClassName == "Model" and not isPlayerCharacter(d) then
				local hum = safe(function() return d:FindFirstChildOfClass("Humanoid") end)
				local pos = getPos(d)
				if hum and pos and dist(pos, myPos()) < CONFIG.train.clickRange then
					list[#list + 1] = { inst = d, name = tostring(d.Name), pos = pos, fallback = true }
				end
			end
		end
	end
	STATE.dummies = list
	return list
end

local function nearestDummy()
	local mine = myPos()
	local best, bestD = nil, math.huge
	for _, d in ipairs(STATE.dummies) do
		local dd = dist(mine, d.pos)
		if dd < bestD then best, bestD = d, dd end
	end
	if best and bestD <= CONFIG.train.clickRange then return best, bestD end
	return nil, bestD
end

local function refreshDummy(force)
	local t = os.clock()
	if force or t - STATE.timers.dummy > 2 or #STATE.dummies == 0 then
		STATE.timers.dummy = t
		scanDummies()
	end
	local d, dd = nearestDummy()
	STATE.dummy = d
	STATE.dummyDist = dd
	return d
end

