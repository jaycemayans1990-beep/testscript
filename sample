-- silent_aim_mobile.lua — Silent Aim (camera-based) for mobile/Delta
-- Designed for ACS-based FPS (place 118367369949006). Tested schema:
--   Teams: Mercenaries / Task Force (Joining ignored)
--   R15: Head, UpperTorso, HumanoidRootPart
--   Camera: Custom, CFrame writable, touch-only
--   Executor: Drawing, gethui, hookmetamethod available
--
-- Usage (Delta): loadstring(game:HttpGet("<bridge>/scripts/silent_aim_mobile.lua"))()
-- Toggle: tap the on-screen [AIM] button (top-left) or _G.SAIM.setEnabled(bool)
-- Unload: _G.SAIM.unload()

if _G.SAIM and _G.SAIM.unload then pcall(_G.SAIM.unload) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Teams = game:GetService("Teams")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local CFG = {
    Enabled = true,
    TeamCheck = true,
    WallCheck = true,
    FOV = 180,              -- pixels radius from screen center (800x450 viewport)
    ShowFOV = true,
    Smooth = 0.35,          -- 0..1 lerp per frame (lower = smoother/"more silent")
    AimPart = "Head",       -- "Head" or "HumanoidRootPart" or "UpperTorso"
    MaxDist = 1500,
    Prediction = 0,         -- studs/sec * seconds (0 = off; set small if needed)
    RequireAlive = true,
    Sticky = true,          -- keep current target while valid
    StickyBreakFOV = 1.6,   -- multiplier to drop sticky target
    MinHealth = 1,
}

local state = {
    target = nil,
    targetName = nil,
    lastAngle = math.huge,
    conns = {},
    drawing = {},
    gui = nil,
}

local function safe(f, d)
    local ok, v = pcall(f)
    if ok then return v end
    return d
end

local function getTeamName(plr)
    local t = safe(function() return plr.Team end, nil)
    if t then
        local n = safe(function() return t.Name end, nil)
        if n and n ~= "" then return n end
    end
    return nil
end

local function myTeam()
    return getTeamName(LP)
end

local function isEnemy(plr)
    if plr == LP then return false end
    local tn = getTeamName(plr)
    if not tn or tn == "" or tn == "Joining" then
        -- treat as non-target if no real team
        if CFG.TeamCheck then return false end
    end
    if CFG.TeamCheck then
        local mine = myTeam()
        if mine and tn and mine == tn then return false end
        -- if either side unknown, be conservative
        if not mine or not tn then return false end
    end
    return true
end

local function getChar(plr)
    local ch = safe(function() return plr.Character end, nil)
    if not ch then return nil end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    if CFG.RequireAlive and hum.Health <= (CFG.MinHealth or 1) then return nil end
    return ch, hum
end

local function getAimPart(ch)
    local p = ch:FindFirstChild(CFG.AimPart) or ch:FindFirstChild("Head") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("HumanoidRootPart")
    if p and p:IsA("BasePart") then return p end
    return nil
end

local function worldToScreen(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on and v.Z > 0, v.Z
end

local function screenCenter()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

local function isVisible(origin, targetPos, targetChar)
    if not CFG.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {safe(function() return LP.Character end, nil), Camera}
    params.FilterDescendantsInstances = exclude
    params.IgnoreWater = true
    local dir = targetPos - origin
    local res = workspace:Raycast(origin, dir, params)
    if not res then return true end
    local inst = res.Instance
    if inst and targetChar and inst:IsDescendantOf(targetChar) then return true end
    -- allow thin/translucent accessories? mostly ignore, but be permissive to reduce false blocks
    if inst and inst:IsA("BasePart") then
        if inst.Transparency >= 0.8 or inst.CanCollide == false then
            -- try again excluding hit part's model-ish? simple: accept borderline transparent
            return false
        end
    end
    return false
end

local function predictPos(part, plr)
    if (CFG.Prediction or 0) <= 0 then return part.Position end
    local vel = safe(function() return part.AssemblyLinearVelocity end, Vector3.zero) or Vector3.zero
    -- damp vertical prediction a bit
    vel = Vector3.new(vel.X, vel.Y * 0.3, vel.Z)
    return part.Position + vel * CFG.Prediction
end

local function validTarget(plr)
    if not isEnemy(plr) then return nil end
    local ch, hum = getChar(plr)
    if not ch or not hum then return nil end
    local part = getAimPart(ch)
    if not part then return nil end
    local aimPos = predictPos(part, plr)
    local sc, on, depth = worldToScreen(aimPos)
    if not on then return nil end
    local center = screenCenter()
    local dist2d = (sc - center).Magnitude
    local dist3d = (aimPos - Camera.CFrame.Position).Magnitude
    if dist3d > CFG.MaxDist then return nil end
    local vis = isVisible(Camera.CFrame.Position, aimPos, ch)
    if CFG.WallCheck and not vis then return nil end
    return {
        plr = plr, ch = ch, hum = hum, part = part,
        aimPos = aimPos, screen = sc, dist2d = dist2d, dist3d = dist3d
    }
end

local function pickTarget()
    -- sticky
    if CFG.Sticky and state.target then
        local okPlr = state.target
        if okPlr and okPlr.Parent == Players then
            local vt = validTarget(okPlr)
            if vt and vt.dist2d <= CFG.FOV * (CFG.StickyBreakFOV or 1.5) then
                return vt
            end
        end
        state.target = nil
    end

    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        local vt = validTarget(plr)
        if vt and vt.dist2d <= CFG.FOV and vt.dist2d < bestD then
            best, bestD = vt, vt.dist2d
        end
    end
    if best and CFG.Sticky then state.target = best.plr end
    return best
end

local function aimAt(pos)
    local camPos = Camera.CFrame.Position
    local desired = CFrame.lookAt(camPos, pos)
    local s = math.clamp(CFG.Smooth or 0.35, 0.01, 1)
    Camera.CFrame = Camera.CFrame:Lerp(desired, s)
    local curLook = Camera.CFrame.LookVector
    local want = (pos - camPos)
    if want.Magnitude > 1e-3 then
        state.lastAngle = math.deg(math.acos(math.clamp(curLook:Dot(want.Unit), -1, 1)))
    end
end

-- Drawing FOV circle
local function setupDrawing()
    local ok = pcall(function()
        if type(Drawing) ~= "table" and type(Drawing) ~= "userdata" then return end
        local c = Drawing.new("Circle")
        c.Thickness = 1.5
        c.NumSides = 64
        c.Filled = false
        c.Transparency = 0.9
        c.Color = Color3.fromRGB(255, 80, 80)
        c.Visible = false
        state.drawing.fov = c
    end)
    if not ok then state.drawing.fov = nil end
end

local function updateFOV()
    local c = state.drawing.fov
    if not c then return end
    c.Visible = CFG.ShowFOV and CFG.Enabled
    if c.Visible then
        c.Position = screenCenter()
        c.Radius = CFG.FOV
        c.Color = state.targetName and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 80)
    end
end

-- Toggle GUI (mobile)
local function setupGUI()
    local parent = nil
    pcall(function() if type(gethui)=="function" then parent = gethui() end end)
    if not parent then
        local ok, pg = pcall(function() return LP:WaitForChild("PlayerGui", 2) end)
        if ok then parent = pg end
    end
    if not parent then return end
    local sg = Instance.new("ScreenGui")
    sg.Name = "SAIM_GUI"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    pcall(function() sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
    sg.Parent = parent

    local btn = Instance.new("TextButton")
    btn.Name = "Toggle"
    btn.Size = UDim2.new(0, 72, 0, 32)
    btn.Position = UDim2.new(0, 10, 0, 60)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.BackgroundTransparency = 0.25
    btn.BorderSizePixel = 0
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.AutoButtonColor = true
    btn.Parent = sg
    local corner = Instance.new("UICorner", btn); corner.CornerRadius = UDim.new(0,8)

    local lbl = Instance.new("TextLabel")
    lbl.Name = "Status"
    lbl.Size = UDim2.new(0, 220, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 96)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(230,230,230)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = ""
    lbl.Parent = sg

    state.gui = {sg=sg, btn=btn, lbl=lbl}

    local function refreshBtn()
        if CFG.Enabled then
            btn.Text = "AIM: ON"
            btn.BackgroundColor3 = Color3.fromRGB(20, 90, 40)
        else
            btn.Text = "AIM: OFF"
            btn.BackgroundColor3 = Color3.fromRGB(90, 30, 30)
        end
    end
    refreshBtn()

    btn.MouseButton1Click:Connect(function()
        CFG.Enabled = not CFG.Enabled
        if not CFG.Enabled then state.target=nil; state.targetName=nil end
        refreshBtn()
    end)

    state.gui.refreshBtn = refreshBtn
end

local function mainStep()
    if not Camera then Camera = workspace.CurrentCamera end
    if not Camera then return end
    updateFOV()
    if not CFG.Enabled then
        state.targetName = nil
        if state.gui and state.gui.lbl then state.gui.lbl.Text = "off" end
        return
    end
    local vt = pickTarget()
    if vt then
        state.targetName = vt.plr.Name
        aimAt(vt.aimPos)
        if state.gui and state.gui.lbl then
            state.gui.lbl.Text = string.format("%s | %.0fpx | %.0fm | %.1f°", vt.plr.Name, vt.dist2d, vt.dist3d, state.lastAngle or 0)
        end
    else
        state.targetName = nil
        if state.gui and state.gui.lbl then state.gui.lbl.Text = "no target" end
    end
end

setupDrawing()
setupGUI()
state.conns.render = RunService.RenderStepped:Connect(mainStep)

_G.SAIM = {
    CFG = CFG,
    state = state,
    setEnabled = function(v)
        CFG.Enabled = not not v
        if state.gui and state.gui.refreshBtn then state.gui.refreshBtn() end
    end,
    setFOV = function(v) CFG.FOV = tonumber(v) or CFG.FOV end,
    setSmooth = function(v) CFG.Smooth = tonumber(v) or CFG.Smooth end,
    status = function()
        return {
            enabled = CFG.Enabled,
            target = state.targetName,
            angle = state.lastAngle,
            team = getTeamName(LP),
            fov = CFG.FOV,
            smooth = CFG.Smooth,
            vp = tostring(Camera and Camera.ViewportSize),
        }
    end,
    unload = function()
        CFG.Enabled = false
        for _,c in pairs(state.conns) do pcall(function() c:Disconnect() end) end
        state.conns = {}
        pcall(function() if state.drawing.fov then state.drawing.fov:Remove() end end)
        pcall(function() if state.gui and state.gui.sg then state.gui.sg:Destroy() end end)
        _G.SAIM = nil
    end,
}

print("[SAIM] loaded | team="..tostring(getTeamName(LP)).." vp="..tostring(Camera.ViewportSize).." fov="..tostring(CFG.FOV).." smooth="..tostring(CFG.Smooth))
return _G.SAIM
