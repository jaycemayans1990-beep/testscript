local acc = 0
table.insert(CONNS, RunService.Heartbeat:Connect(function(dt)
	acc = acc + dt
	if acc >= 1 / math.max(CONFIG.esp.updateRate, 10) then
		acc = 0
		espPass()
	end
end))

RunService:BindToRenderStep("AX_AIM_STEP", Enum.RenderPriority.Camera.Value + 1, function()
	aimStep()
	updateFov()
end)

