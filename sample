local FOVCircle
do
    local okDraw, drawObj = pcall(function() return Drawing.new("Circle") end)
    if okDraw and drawObj then
        FOVCircle = drawObj
    else
        -- FIXED: better fallback that won't error on property writes
        FOVCircle = {
            Visible = false,
            _pos = Vector2.new(0, 0),
            _radius = 0,
            Thickness = 1.5,
            Color = Color3.fromRGB(255, 255, 255),
            Filled = false,
            Transparency = 0.7,
            NumSides = 64,
            Remove = function() end,
        }
        -- Proxy property writes to dummy fields
        local mt = {
            __index = function(t, k)
                if k == "Position" then return rawget(t, "_pos") end
                if k == "Radius" then return rawget(t, "_radius") end
                return rawget(t, k)
            end,
            __newindex = function(t, k, v)
                if k == "Position" then rawset(t, "_pos", v)
                elseif k == "Radius" then rawset(t, "_radius", v)
                else rawset(t, k, v) end
            end
        }
        setmetatable(FOVCircle, mt)
        setGlxStatus("Drawing unavailable — FOV circle disabled")
    end
end
