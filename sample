    local tpGui = Instance.new("ScreenGui"); tpGui.Name = "Glx_BehindTP"; tpGui.ResetOnSpawn = false
    tpGui.DisplayOrder = 999998; tpGui.Parent = ScreenGui.Parent or game:GetService("CoreGui"); tpGui.Enabled = false
    CleanupManager:AddInstance("TPGui", tpGui)
    local box = Instance.new("Frame"); box.Size = UDim2.fromOffset(44, 44); box.Position = UDim2.new(0, 84, 0, 130)
    box.BackgroundColor3 = Color3.fromRGB(18, 18, 18); box.BackgroundTransparency = 0.2; box.BorderSizePixel = 0
    box.Active = true; box.Parent = tpGui; Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)
    local tpBtn = Instance.new("TextButton"); tpBtn.Size = UDim2.fromScale(1, 1); tpBtn.BackgroundTransparency = 1
    tpBtn.Font = Enum.Font.GothamBold; tpBtn.TextSize = 15; tpBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    tpBtn.Text = "TP"; tpBtn.Parent = box
    local lockBadge = Instance.new("TextButton"); lockBadge.Size = UDim2.fromOffset(18, 18)
    lockBadge.Position = UDim2.new(1, -8, 0, -8); lockBadge.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    lockBadge.BorderSizePixel = 0; lockBadge.Font = Enum.Font.SourceSans; lockBadge.TextSize = 12
    lockBadge.Text = "\u{1F513}"; lockBadge.Parent = box; Instance.new("UICorner", lockBadge).CornerRadius = UDim.new(1, 0)

    local function pickTarget()
        local cam = Workspace.CurrentCamera; if not cam then return nil end
        local myChar = LocalPlayer.Character
        local checkEnemy = isValidEnemyFn or function(plr) return plr ~= LocalPlayer end

        -- 1) ray จากกลางจอ — ต้องเป็นศัตรูจริง (ใช้ isValidEnemy: เคารพ TeamCheck/forcefield/HP)
        local rayParams = RaycastParams.new(); rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = myChar and { myChar } or {}
        local hit = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 1000, rayParams)
        if hit then
            local model = hit.Instance:FindFirstAncestorOfClass("Model")
            local plr = model and Players:GetPlayerFromCharacter(model)
            if plr and checkEnemy(plr) then
                local char = plr.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then return root end
            end
        end

        -- 2) fallback: ใกล้กลางจอที่สุด — เดิมถ้า crosshair โดนเพื่อน/NPC จะ return nil ทันที (TP ไม่ทำงาน)
        local vp = cam.ViewportSize * 0.5
        local best, bestDist
        for _, plr in ipairs(Players:GetPlayers()) do
            if checkEnemy(plr) then
                local char = plr.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local sp, on = cam:WorldToViewportPoint(root.Position)
                    if on and sp.Z > 0 then
                        local d = (Vector2.new(sp.X, sp.Y) - vp).Magnitude
                        if not bestDist or d < bestDist then best, bestDist = root, d end
                    end
                end
            end
        end
        return best
    end

    -- FIXED: เดิมใช้ target.CFrame * CFrame.new(0, 0, -DIST) ซึ่ง = "หน้าเป้า" (LookVector = -Z)
    --        → โผล่หน้าเป้าแล้วหันหลังให้เป้า (dot offset กับ LookVector = +10)
    -- คืนค่า: spot (หลังเป้า), fwd (ทิศที่เป้ามอง → ใช้หันกลับไปหาเป้า)
    local function computeSpot(targetCF)
        local lv = targetCF.LookVector
        local fwd = Vector3.new(lv.X, 0, lv.Z)
        if fwd.Magnitude < 0.05 then fwd = Vector3.new(0, 0, -1) else fwd = fwd.Unit end
        return targetCF.Position - fwd * DIST, fwd
    end

    local function teleport()
        if not State.Teleport then setGlxStatus("Teleport is OFF"); return end
        local now = os.clock()
        if now - lastTP < TP_COOLDOWN then return end   -- กันสแปม CFrame (โดน rubber-band/flag)

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not (hum and myRoot and hum.Health > 0) then setGlxStatus("No character for TP"); return end

        local target = pickTarget()
        if not target then setGlxStatus("No valid target found for TP"); return end

        local spot, fwd = computeSpot(target.CFrame)

        -- กันไปโผล่ในผนัง: ray จากเป้าไปจุดหมาย ถ้ามีของกั้นให้ขยับเข้ามาใกล้เป้า
        local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { char, target.Parent }
        local dir = spot - target.Position
        if dir.Magnitude > 1e-3 then
            local okRay, block = pcall(Workspace.Raycast, Workspace, target.Position, dir, rp)
            if okRay and block and type(block.Distance) == "number" and block.Distance < dir.Magnitude - 0.5 then
                spot = target.Position + dir.Unit * math.max(block.Distance - 1.5, 2)
            end
        end

        -- วางบนพื้น (กันลอย/จมดิน เพราะ Y ของเป้าไม่ใช่ Y ของจุดหมาย)
        local grp = RaycastParams.new(); grp.FilterType = Enum.RaycastFilterType.Exclude
        grp.FilterDescendantsInstances = { char, target.Parent }
        local okG, ground = pcall(Workspace.Raycast, Workspace, spot + Vector3.new(0, 4, 0), Vector3.new(0, -30, 0), grp)
        if okG and ground then
            spot = Vector3.new(spot.X, ground.Position.Y + 3, spot.Z)
        end

        lastTP = now
        pcall(function() hum.Sit = false end)
        pcall(function()
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end)
        myRoot.CFrame = CFrame.lookAt(spot, spot + fwd)   -- อยู่หลังเป้า + หันเข้าหาเป้า
        setGlxStatus("TP behind " .. (target.Parent and target.Parent.Name or "target"))
    end

    local locked = false; local dragInput, dragStart, startPos
    local function isPress(io) return io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 end
    tpBtn.InputBegan:Connect(function(io) if isPress(io) then dragInput, dragStart, startPos = io, io.Position, box.Position end end)
    CleanupManager:AddConn("TPDragMoved", UserInputService.InputChanged:Connect(function(io)
        if io ~= dragInput or locked then return end
        local d = io.Position - dragStart; box.Position = startPos + UDim2.fromOffset(d.X, d.Y)
    end))
    CleanupManager:AddConn("TPDragEnded", UserInputService.InputEnded:Connect(function(io)
        if io ~= dragInput then return end; dragInput = nil
        if (io.Position - dragStart).Magnitude <= TAP_SLOP then teleport() end
    end))
    lockBadge.Activated:Connect(function() locked = not locked; lockBadge.Text = locked and "\u{1F512}" or "\u{1F513}" end)
    TPService = {
        setEnabled = function(on) tpGui.Enabled = on and true or false end,
        Teleport = teleport, PickTarget = pickTarget,
    }
    getgenv().Glx_TP = { Teleport = teleport, PickTarget = pickTarget, ComputeSpot = computeSpot, State = State }
end

if TPService and TPService.setEnabled then TPService.setEnabled(State.Teleport) end
