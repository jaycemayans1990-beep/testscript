-- 5. VISIBILITY SERVICE (optimized — shared cache)
-- ==========================================
local VisibilityService = {}
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true
local ScratchFilter = {}
local lastFilterCount, lastFilterFirst = -1, nil

-- Shared visibility cache: maps Character -> { visible, checkedAt, pierceCount }
local VisCache = setmetatable({}, { __mode = "k" })
local VIS_CACHE_TTL = 0.15 -- cache valid for 150ms (shared between aimbot + ESP)

function VisibilityService:CheckVisibility(targetCharacter, pierceCount, specificPart)
    local camera = getCamera()
    if not (camera and targetCharacter) then return false end
    
    -- Check cache first (only for non-specific-part lookups with standard pierce)
    if not specificPart and (pierceCount or 1) <= 5 then
        local entry = VisCache[targetCharacter]
        if entry and os.clock() - entry.checkedAt < VIS_CACHE_TTL then
            return entry.visible
        end
    end
    
    local targetPart = specificPart
    if not (targetPart and targetPart.Parent) then
        targetPart = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
    end
    if not targetPart then
        if not specificPart then VisCache[targetCharacter] = { visible = false, checkedAt = os.clock() } end
        return false
    end
    
    local origin = camera.CFrame.Position
    local targetPos = targetPart.Position
    local direction = targetPos - origin
    local distToTarget = direction.Magnitude
    if distToTarget < 0.05 then
        if not specificPart then VisCache[targetCharacter] = { visible = true, checkedAt = os.clock() } end
        return true
    end
    
    local maxPierces = pierceCount or 1
    local currentOrigin = origin
    local currentDirection = direction
    table.clear(ScratchFilter)
    local n = 0
    local myChar = LocalPlayer and LocalPlayer.Character
    if myChar then n += 1; ScratchFilter[n] = myChar end
    local filterDirty = (n ~= lastFilterCount) or (ScratchFilter[1] ~= lastFilterFirst)
    
    for i = 1, maxPierces do
        if filterDirty then
            lastFilterCount, lastFilterFirst = n, ScratchFilter[1]
            RayParams.FilterDescendantsInstances = ScratchFilter
            filterDirty = false
        end
        local okRay, result = pcall(Workspace.Raycast, Workspace, currentOrigin, currentDirection, RayParams)
        if not okRay or not result then
            if not specificPart then VisCache[targetCharacter] = { visible = true, checkedAt = os.clock() } end
            return true
        end
        local hitDist = result.Distance
        if math.abs(hitDist - distToTarget) < 0.03 then
            if not specificPart then VisCache[targetCharacter] = { visible = true, checkedAt = os.clock() } end
            return true
        end
        local hitPart = result.Instance
        if hitPart:IsDescendantOf(targetCharacter) then
            if not specificPart then VisCache[targetCharacter] = { visible = true, checkedAt = os.clock() } end
            return true
        end
        if i < maxPierces and (hitPart.Transparency > 0.8 or not hitPart.CanCollide) then
            n += 1; ScratchFilter[n] = hitPart; filterDirty = true
            local seg = targetPos - result.Position
            local segUnit = safeUnit(seg)
            if not segUnit then
                if not specificPart then VisCache[targetCharacter] = { visible = true, checkedAt = os.clock() } end
                return true
            end
            currentOrigin = result.Position + segUnit * 0.05
            currentDirection = seg
        else
            if not specificPart then VisCache[targetCharacter] = { visible = false, checkedAt = os.clock() } end
            return false
        end
    end
    if not specificPart then VisCache[targetCharacter] = { visible = false, checkedAt = os.clock() } end
    return false
end

-- Invalidate cache when a player leaves
CleanupManager:AddConn("VisCacheCleanup", Players.PlayerRemoving:Connect(function(player)
    if player.Character then VisCache[player.Character] = nil end
end))

