-- 5.1 ENEMY VALIDITY
-- ==========================================
local PlayerCache = setmetatable({}, { __mode = "k" })
local function getComponents(player)
    local char = player.Character
    if not char then PlayerCache[player] = nil; return nil end
    local entry = PlayerCache[player]
    if not entry or entry.Character ~= char then
        entry = {
            Character = char,
            Humanoid = char:FindFirstChildOfClass("Humanoid"),
            Root = char:FindFirstChild("HumanoidRootPart"),
            Head = char:FindFirstChild("Head"),
            UpperTorso = char:FindFirstChild("UpperTorso"),
            LowerTorso = char:FindFirstChild("LowerTorso")
        }
        PlayerCache[player] = entry
    end
    -- FIXED v3.17.1: re-fetch nil OR stale references (was: only re-fetched non-nil)
    -- Old logic skipped nil → cache poisoned when parts hadn't loaded yet → player permanently invisible to ESP
    if not entry.Humanoid or entry.Humanoid.Parent ~= char then entry.Humanoid = char:FindFirstChildOfClass("Humanoid") end
    if not entry.Root or entry.Root.Parent ~= char then entry.Root = char:FindFirstChild("HumanoidRootPart") end
    if not entry.Head or entry.Head.Parent ~= char then entry.Head = char:FindFirstChild("Head") end
    -- Also re-fetch torso parts (used by aimbot, added for completeness)
    if not entry.UpperTorso or entry.UpperTorso.Parent ~= char then entry.UpperTorso = char:FindFirstChild("UpperTorso") end
    if not entry.LowerTorso or entry.LowerTorso.Parent ~= char then entry.LowerTorso = char:FindFirstChild("LowerTorso") end
    return entry
end

local function isValidEnemy(player)
    if not player or player == LocalPlayer then return false end
    local entry = getComponents(player)
    if not entry then return false end
    local humanoid, root = entry.Humanoid, entry.Root
    if not humanoid or humanoid.Health <= 0 then return false end
    if not root or root.Parent ~= entry.Character then return false end
    local nowFF = os.clock()
    if nowFF >= (entry.FFCheckUntil or 0) then
        entry.HasForceField = entry.Character:FindFirstChildOfClass("ForceField") ~= nil
        entry.FFCheckUntil = nowFF + 0.25
    end
    if entry.HasForceField then return false end
    if State.TeamCheck then
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
        if player.TeamColor and LocalPlayer.TeamColor and player.TeamColor == LocalPlayer.TeamColor then return false end
    end
    return true
end
isValidEnemyFn = isValidEnemy   -- ให้ TP service (Part 1/5) ใช้ team/forcefield check ชุดเดียวกับ ESP/aimbot
CleanupManager:AddConn("PlayerRemovingCaches", Players.PlayerRemoving:Connect(function(player)
    PlayerCache[player] = nil
    if player.Character then VisCache[player.Character] = nil end
end))

