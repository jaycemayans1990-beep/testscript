ESPService = {
    Cache = {},
    COLOR_VISIBLE = Color3.fromRGB(0, 255, 128),
    COLOR_OBSTRUCTED = Color3.fromRGB(255, 50, 50),
    OUTLINE_VISIBLE = Color3.fromRGB(255, 215, 0),
    OUTLINE_OBSTRUCTED = Color3.fromRGB(100, 0, 0)
}
local ESPRegistry = setmetatable({}, { __mode = "k" })

local function destroyEntryVisuals(entry)
    if not entry then return end
    if entry.Highlight then pcall(entry.Highlight.Destroy, entry.Highlight); entry.Highlight = nil end
    if entry.NameTag then pcall(entry.NameTag.Destroy, entry.NameTag); entry.NameTag = nil end
    entry.Label = nil; entry.ShownVisible = nil
end

function ESPService:ClearAll()
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then
            local hl = char:FindFirstChild("ESP_Highlight")
            if hl then hl:Destroy() end
            local nt = char:FindFirstChild("ESP_NameTag")
            if nt then nt:Destroy() end
        end
    end
    table.clear(self.Cache)
end
CleanupManager:AddCustomCleanup(function() ESPService:ClearAll() end)
CleanupManager:AddConn("PlayerRemovingESP", Players.PlayerRemoving:Connect(function(player)
    destroyEntryVisuals(ESPService.Cache[player])
    ESPService.Cache[player] = nil
end))

clearESPVisuals = function(highlightToo, nameTagToo)
    for _, entry in pairs(ESPService.Cache) do
        if highlightToo and entry.Highlight then
            pcall(entry.Highlight.Destroy, entry.Highlight)
            entry.Highlight = nil; entry.ShownVisible = nil
        end
        if nameTagToo and entry.NameTag then
            pcall(entry.NameTag.Destroy, entry.NameTag)
            entry.NameTag = nil; entry.Label = nil
        end
    end
end

local function buildNameTag(char, head, text)
    local nameTag = Instance.new("BillboardGui")
    nameTag.Name = "ESP_NameTag"; nameTag.Adornee = head
    nameTag.Size = UDim2.new(0, 150, 0, 30)
    nameTag.StudsOffset = Vector3.new(0, 2, 0)
    nameTag.AlwaysOnTop = true; nameTag.MaxDistance = 1500
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "TagLabel"; textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1; textLabel.Text = text
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Font = Enum.Font.SourceSansBold; textLabel.TextSize = 14
    textLabel.Parent = nameTag; nameTag.Parent = char
    ESPRegistry[nameTag] = true
    return nameTag
end

function ESPService:ProcessESP()
    if not State.ESP and not State.ESPName then return end
    local now = os.clock()
    local players = Players:GetPlayers()
    
    for i = 1, #players do
        local player = players[i]
        if player ~= LocalPlayer then
            local char = player.Character
            if not char then
                destroyEntryVisuals(self.Cache[player])
                self.Cache[player] = nil
            else
                local entry = self.Cache[player]
                if not entry or entry.Character ~= char then
                    destroyEntryVisuals(entry)
                    entry = {
                        Character = char,
                        Visible = false, LastCheck = 0,
                        Highlight = char:FindFirstChild("ESP_Highlight"),
                        NameTag = char:FindFirstChild("ESP_NameTag"),
                        ShownVisible = nil
                    }
                    self.Cache[player] = entry
                end
                
                local isEnemy = isValidEnemy(player)
                if not isEnemy or (not State.ESP and not State.ESPName) then
                    if entry.Highlight then entry.Highlight:Destroy(); entry.Highlight = nil end
                    if entry.NameTag then entry.NameTag:Destroy(); entry.NameTag = nil end
                    entry.Label = nil; entry.ShownVisible = nil
                else
                    -- Use shared visibility cache (same cache as aimbot!)
                    if now - entry.LastCheck >= 0.35 then
                        entry.Visible = VisibilityService:CheckVisibility(char, 5, nil)
                        entry.LastCheck = now
                    end
                    
                    if State.ESP then
                        local hl = entry.Highlight
                        if not hl or hl.Parent ~= char then
                            if hl then pcall(hl.Destroy, hl) end
                            hl = Instance.new("Highlight")
                            hl.Name = "ESP_Highlight"
                            hl.FillTransparency = 0.25
                            hl.Parent = char
                            entry.Highlight = hl
                            ESPRegistry[hl] = true
                            entry.ShownVisible = nil
                        end
                        if entry.ShownVisible ~= entry.Visible then
                            hl.FillColor = entry.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                            hl.OutlineColor = entry.Visible and self.OUTLINE_VISIBLE or self.OUTLINE_OBSTRUCTED
                            entry.ShownVisible = entry.Visible
                        end
                    elseif entry.Highlight then
                        entry.Highlight:Destroy(); entry.Highlight = nil
                        entry.ShownVisible = nil
                    end
                    
                    if State.ESPName then
                        local head = entry.Head
                        if head and head.Parent ~= char then head = nil; entry.Head = nil end
                        if not head then
                            head = char:FindFirstChild("Head")
                            if head then entry.Head = head end
                        end
                        if head then
                            local nt = entry.NameTag
                            if not nt or nt.Parent ~= char then
                                entry.NameTag = buildNameTag(char, head, player.DisplayName or player.Name)
                                nt = entry.NameTag
                                entry.Label = nt and nt:FindFirstChild("TagLabel") or nil
                            end
                            local label = entry.Label
                            if label and label.Parent == nt then
                                local color = entry.Visible and self.COLOR_VISIBLE or self.COLOR_OBSTRUCTED
                                if label.TextColor3 ~= color then label.TextColor3 = color end
                            end
                        elseif entry.NameTag then
                            entry.NameTag:Destroy(); entry.NameTag = nil
                            entry.Label = nil
                        end
                    elseif entry.NameTag then
                        entry.NameTag:Destroy(); entry.NameTag = nil
                        entry.Label = nil
                    end
                end
            end
        end
    end
end

local espAccumulator = 0; local ESP_INTERVAL = 1/30
local lastEspTick = os.clock(); local espErrStreak = 0
local espProcessFn = function() ESPService:ProcessESP() end
local traceFn = function(e)
    local ok, tb = pcall(function() return debug.traceback(e) end)
    return ok and tb or tostring(e)
end

local function connectESP()
    CleanupManager:AddConn("ESP_Heartbeat", RunService.Heartbeat:Connect(function(dt)
        lastEspTick = os.clock()
        if not State.ESP and not State.ESPName then return end
        espAccumulator += dt
        if espAccumulator >= ESP_INTERVAL then
            espAccumulator = 0
            local ok, err = xpcall(espProcessFn, traceFn)
            if ok then espErrStreak = 0
            else
                espErrStreak += 1
                if espErrStreak == 5 then
                    warn("[GLX v3.17] ESP tick error: "..tostring(err))
                    if setStickyStatus then setStickyStatus("ESP error: "..tostring(err):sub(1,40)) end
                end
            end
        end
    end))
end
connectESP()

-- Sweeper: clean orphaned ESP tags every 8s (reduced from 5s)
task.spawn(function()
    while getgenv().Glx_Cleanup == CleanupManager and task.wait(8) do
        local owned = {}
        for _, entry in pairs(ESPService.Cache) do
            if entry.Highlight or entry.NameTag then
                if entry.Highlight then owned[entry.Highlight] = true end
                if entry.NameTag then owned[entry.NameTag] = true end
            end
        end
        local sweepRemove = {}
        for inst in pairs(ESPRegistry) do
            if inst.Parent and not owned[inst] then
                sweepRemove[#sweepRemove+1] = inst
            end
        end
        for _, inst in ipairs(sweepRemove) do
            ESPRegistry[inst] = nil
            pcall(inst.Destroy, inst)
        end
        for _, player in ipairs(Players:GetPlayers()) do
            local char = player.Character
            if char then
                for _, child in ipairs(char:GetChildren()) do
                    if (child.Name == "ESP_Highlight" or child.Name == "ESP_NameTag") and not owned[child] then
                        pcall(child.Destroy, child)
                    end
                end
            end
        end
    end
end)

