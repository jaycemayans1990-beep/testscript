local cachedPing, pingUntil = 0.025, 0
local function getPing()
    if not LocalPlayer then return 0.025 end
    local now = os.clock()
    if now >= pingUntil then
        local success, ping = pcall(LocalPlayer.GetNetworkPing, LocalPlayer)
        local raw = (success and type(ping) == "number" and ping > 0) and ping or 0.025
        -- FIXED v3.17.1: EMA — ping ดิบกระโดดทุก 0.5s → lead time เปลี่ยน → จุดเล็งกระโดด → กล้องกระตุก
        cachedPing += (raw - cachedPing) * 0.35
        pingUntil = now + 0.5
    end
    return cachedPing
end

