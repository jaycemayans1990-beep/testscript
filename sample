---------------------------------------------------------------------------
-- player / character utilities
---------------------------------------------------------------------------
local function getChar(plr)
	local ok, c = pcall(function() return plr.Character end)
	if ok and c and c.Parent then return c end
	return nil
end

local function alive(char)
	local h = char and char:FindFirstChildOfClass("Humanoid")
	if not h then return false end
	return h.Health > 0
end

local function partOf(char, name)
	if not char then return nil end
	local ok, p = pcall(function() return char:FindFirstChild(name) end)
	return ok and p or nil
end

local function isTeamMate(plr)
	if plr == LP then return true end
	local ok, myTeam = pcall(function() return LP.Team end)
	if not ok or not myTeam then return false end
	local ok2, theirTeam = pcall(function() return plr.Team end)
	return ok2 and theirTeam == myTeam
end

local function anyTeamCheck()
	return CONFIG.esp.teamCheck or CONFIG.aim.teamCheck
end

---------------------------------------------------------------------------
-- screen projection
---------------------------------------------------------------------------
local function project(pos)
	local cam = Workspace.CurrentCamera
	if not cam then return Vector2.zero, false end
	local sp, onScreen = cam:WorldToViewportPoint(pos)
	return Vector2.new(sp.X, sp.Y), onScreen and sp.Z > 0
end

-- screen-space bounds from the model's own bounding box (rig-agnostic)
local function screenBounds(char)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end

	local ok, cf, size = pcall(function()
		local c, s = char:GetBoundingBox()
		return c, s
	end)

	if not ok or not cf then
		local head = partOf(char, "Head")
		local root = partOf(char, "HumanoidRootPart")
		if not head or not root then return nil end
		local a, aOn = project(head.Position + Vector3.new(0, 0.9, 0))
		local b, bOn = project(root.Position - Vector3.new(0, 3.1, 0))
		if not aOn or not bOn then return nil end
		local h = math.abs(b.Y - a.Y)
		local w = h * 0.55
		return { x = (a.X + b.X) * 0.5 - w * 0.5, y = a.Y, w = w, h = h }
	end

	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	local any = false
	for _, sx in ipairs({ -0.5, 0.5 }) do
		for _, sy in ipairs({ -0.5, 0.5 }) do
			for _, sz in ipairs({ -0.5, 0.5 }) do
				local wpos = (cf * CFrame.new(size.X * sx, size.Y * sy, size.Z * sz)).Position
				local sp, on = project(wpos)
				if on then
					any = true
					minX = math.min(minX, sp.X); maxX = math.max(maxX, sp.X)
					minY = math.min(minY, sp.Y); maxY = math.max(maxY, sp.Y)
				end
			end
		end
	end
	if not any then return nil end
	if maxX - minX > 900 or maxY - minY > 1200 then return nil end -- degenerate projection
	return { x = minX, y = minY, w = maxX - minX, h = maxY - minY }
end

local BONES_R15 = {
	{ "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local BONES_R6 = {
	{ "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
	{ "Torso", "Left Leg" }, { "Torso", "Right Leg" },
}
local function boneSet(char)
	if char:FindFirstChild("UpperTorso") then return BONES_R15 end
	if char:FindFirstChild("Torso") then return BONES_R6 end
	return nil
end

---------------------------------------------------------------------------
-- ESP slot: one bucket of Drawing objects per player, created lazily, hidden when idle
---------------------------------------------------------------------------
local SLOTS = {}

local function newSlot()
	return {
		box = nil, fill = nil, name = nil, dist = nil, head = nil, tracer = nil,
		hpBg = nil, hpFg = nil, bones = {}, boneRig = nil, chams = nil, char = nil,
	}
end

local function ensure(slot)
	if not HAS_DRAWING then return slot end
	if not slot.box then
		slot.box  = track(dnew("Square"))
		slot.fill = track(dnew("Square"))
		dset(slot.fill, { Filled = true, Color = CONFIG.esp.boxColor, Transparency = 0.85 })
		slot.hpBg = track(dnew("Square"))
		slot.hpFg = track(dnew("Square"))
		dset(slot.hpBg, { Filled = true, Color = Color3.fromRGB(20, 20, 20), Transparency = 0.35 })
	end
	if not slot.name then
		slot.name = track(dnew("Text"))
		dset(slot.name, { Size = CONFIG.esp.textSize, Center = true, Outline = true, Color = Color3.fromRGB(240, 245, 250) })
		slot.dist = track(dnew("Text"))
		dset(slot.dist, { Size = CONFIG.esp.textSize - 2, Center = true, Outline = true, Color = Color3.fromRGB(215, 220, 230) })
		slot.head = track(dnew("Circle"))
		dset(slot.head, { Thickness = 1.5, Filled = true, Color = CONFIG.esp.enemyColor })
		slot.tracer = track(dnew("Line"))
		dset(slot.tracer, { Thickness = 1, Transparency = 0.35, Color = CONFIG.esp.enemyColor })
	end
	return slot
end

local function hideSlot(slot)
	if not slot then return end
	for _, o in ipairs({ slot.box, slot.fill, slot.hpBg, slot.hpFg, slot.name, slot.dist, slot.head, slot.tracer }) do
		if o then pcall(function() o.Visible = false end) end
	end
	for _, b in ipairs(slot.bones) do pcall(function() b.Visible = false end) end
	if slot.chams then pcall(function() slot.chams.Enabled = false end) end
end

local function freeSlot(slot)
	if not slot then return end
	for _, o in ipairs({ slot.box, slot.fill, slot.hpBg, slot.hpFg, slot.name, slot.dist, slot.head, slot.tracer }) do dfree(o) end
	for _, b in ipairs(slot.bones) do dfree(b) end
	if slot.chams then pcall(function() slot.chams:Destroy() end) end
end

local function ensureBones(slot, char)
	local set = boneSet(char)
	if not set then return end
	if slot.boneRig ~= set then
		for _, b in ipairs(slot.bones) do dfree(b) end
		slot.bones = {}
		slot.boneRig = set
	end
	while #slot.bones < #set do
		local line = track(dnew("Line"))
		dset(line, { Thickness = 1, Transparency = 0.2, Color = CONFIG.esp.boxColor })
		table.insert(slot.bones, line)
	end
end

local function ensureChams(slot, char)
	if not CONFIG.esp.chams then
		if slot.chams then pcall(function() slot.chams.Enabled = false end) end
		return
	end
	if slot.chams and slot.chams.Parent ~= char then
		pcall(function() slot.chams:Destroy() end)
		slot.chams = nil
	end
	if not slot.chams then
		local ok, hl = pcall(Instance.new, "Highlight")
		if ok and hl then
			hl.Name = "AX_Cham"
			hl.FillColor = CONFIG.esp.enemyColor
			hl.FillTransparency = 0.55
			hl.OutlineColor = CONFIG.esp.boxColor
			hl.OutlineTransparency = 0.7
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			pcall(function() hl.Parent = char end)
			slot.chams = hl
		end
	end
	if slot.chams then pcall(function() slot.chams.Enabled = true end) end
end

---------------------------------------------------------------------------
-- ESP draw pass
---------------------------------------------------------------------------
local function drawPlayer(plr, slot, cam)
	local char = getChar(plr)
	if not char or not alive(char) then hideSlot(slot); return end
	slot.char = char

	local root = partOf(char, "HumanoidRootPart")
	local head = partOf(char, "Head")
	if not root or not head then hideSlot(slot); return end

	local camPos = cam.CFrame.Position
	local dist = (root.Position - camPos).Magnitude
	if dist > CONFIG.esp.maxDistance then hideSlot(slot); return end

	local b = screenBounds(char)
	if not b or b.w < 2 or b.h < 2 then hideSlot(slot); return end

	if CONFIG.esp.teamCheck and isTeamMate(plr) then hideSlot(slot); return end
	local col = CONFIG.esp.boxColor

	ensure(slot)

	-- box
	dset(slot.box, { Visible = CONFIG.esp.box, Position = Vector2.new(b.x, b.y), Size = Vector2.new(b.w, b.h), Thickness = 1, Color = col, Filled = false })
	dset(slot.fill, { Visible = CONFIG.esp.box and CONFIG.esp.fill, Position = Vector2.new(b.x, b.y), Size = Vector2.new(b.w, b.h), Color = col })

	-- health bar (5px rail on the left edge)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hp = hum and math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1) or 1
	local barX, barW = b.x - 6, 3
	dset(slot.hpBg, { Visible = CONFIG.esp.health, Position = Vector2.new(barX, b.y), Size = Vector2.new(barW, b.h) })
	dset(slot.hpFg, {
		Visible = CONFIG.esp.health,
		Position = Vector2.new(barX, b.y + b.h * (1 - hp)),
		Size = Vector2.new(barW, math.max(b.h * hp, 1)),
		Color = Color3.fromRGB(math.floor(60 + 195 * (1 - hp)), math.floor(60 + 195 * hp), 90),
	})

	-- name + distance
	dset(slot.name, { Visible = CONFIG.esp.name, Position = Vector2.new(b.x + b.w * 0.5, b.y - 14), Text = plr.Name, Color = col })
	dset(slot.dist, { Visible = CONFIG.esp.distance, Position = Vector2.new(b.x + b.w * 0.5, b.y + b.h + 3), Text = string.format("%dm", math.floor(dist / 4)) })

	-- head dot
	local hp2, onHead = project(head.Position)
	dset(slot.head, { Visible = CONFIG.esp.headDot and onHead, Position = hp2, Radius = math.max(b.w * 0.045, 1.5), Color = CONFIG.esp.enemyColor })

	-- tracer from bottom-centre of the viewport
	local vp = cam.ViewportSize
	dset(slot.tracer, {
		Visible = CONFIG.esp.tracer,
		From = Vector2.new(vp.X * 0.5, vp.Y - 1),
		To = Vector2.new(b.x + b.w * 0.5, b.y + b.h),
		Color = CONFIG.esp.enemyColor,
	})

	-- skeleton
	if CONFIG.esp.skeleton then
		ensureBones(slot, char)
		local set = slot.boneRig
		for i, pair in ipairs(set or {}) do
			local line = slot.bones[i]
			local p1, p2 = partOf(char, pair[1]), partOf(char, pair[2])
			if line and p1 and p2 then
				local s1, o1 = project(p1.Position)
				local s2, o2 = project(p2.Position)
				dset(line, { Visible = o1 and o2, From = s1, To = s2, Color = col })
			elseif line then
				pcall(function() line.Visible = false end)
			end
		end
		for i = #(set or {}) + 1, #slot.bones do pcall(function() slot.bones[i].Visible = false end) end
	else
		for _, line in ipairs(slot.bones) do pcall(function() line.Visible = false end) end
	end

	ensureChams(slot, char)
end

local function espPass()
	local cam = Workspace.CurrentCamera
	if not cam then return end

	if not CONFIG.esp.enabled then
		for _, slot in pairs(SLOTS) do hideSlot(slot) end
		return
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			if anyTeamCheck() and isTeamMate(plr) then
				if SLOTS[plr] then hideSlot(SLOTS[plr]) end
			else
				SLOTS[plr] = SLOTS[plr] or ensure(newSlot())
				drawPlayer(plr, SLOTS[plr], cam)
			end
		end
	end

	-- reclaim slots for players that left
	for plr, slot in pairs(SLOTS) do
		if not plr.Parent then
			freeSlot(slot)
			SLOTS[plr] = nil
		end
	end
end

---------------------------------------------------------------------------
-- target selection / visibility
---------------------------------------------------------------------------
local AIM = { holding = false, locked = false, pressedAt = 0, target = nil }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function hasLineOfSight(part, char)
	local cam = Workspace.CurrentCamera
	if not cam then return false end
	local origin = cam.CFrame.Position
	local filter = { char }
	if LP.Character then table.insert(filter, LP.Character) end
	rayParams.FilterDescendantsInstances = filter
	local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
	if not hit then return true end
	return hit.Instance and hit.Instance:IsDescendantOf(char)
end

local function predictPoint(part, cam)
	local pos = part.Position
	local vel = part.AssemblyLinearVelocity or Vector3.zero
	local dist = (pos - cam.CFrame.Position).Magnitude
	local t
	if CONFIG.aim.projectileSpeed > 0 then
		t = dist / CONFIG.aim.projectileSpeed
	else
		t = CONFIG.aim.prediction
	end
	if t <= 0 then return pos end
	local lead = Vector3.new(vel.X, vel.Y * 0.25, vel.Z) * t
	if lead.Magnitude > 12 then lead = lead.Unit * 12 end -- sanity clamp for teleport-y rigs
	return pos + lead
end

local function pickTarget(cam)
	local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
	local best, bestScore = nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and not (CONFIG.aim.teamCheck and isTeamMate(plr)) then
			local char = getChar(plr)
			if char and alive(char) then
				local part = partOf(char, CONFIG.aim.part) or partOf(char, "HumanoidRootPart")
				if part and (part.Position - cam.CFrame.Position).Magnitude <= CONFIG.aim.maxDistance then
					local sp, on = project(part.Position)
					if on then
						local score = (sp - center).Magnitude
						if score <= CONFIG.aim.fov and score < bestScore then
							if (not CONFIG.aim.visibleOnly) or hasLineOfSight(part, char) then
								best = { plr = plr, char = char, part = part, screen = sp, score = score }
								bestScore = score
							end
						end
					end
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
-- aim application
---------------------------------------------------------------------------
local fovCircle = nil
if HAS_DRAWING then
	fovCircle = dnew("Circle")
	dset(fovCircle, { Thickness = 1, Transparency = 0.45, Filled = false, Color = CONFIG.esp.boxColor, Visible = false })
end

local lastTrigger = 0
local function fireTrigger()
	local gap = math.max(CONFIG.aim.triggerDelay, 0.02)
	if now() - lastTrigger < gap then return end
	lastTrigger = now()
	if HAS_MOUSE1 then
		pcall(mouse1click)
	elseif VIM then
		pcall(function()
			VIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
			task.delay(0.02, function()
				pcall(function() VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1) end)
			end)
		end)
	end
end

local function mouseAim(aimPos)
	local sp, on = project(aimPos)
	if not on then return end
	local cur = UIS:GetMouseLocation()
	local dx = (sp.X - cur.X) * CONFIG.aim.smooth
	local dy = (sp.Y - cur.Y) * CONFIG.aim.smooth
	if CONFIG.aim.humanize then
		dx = dx + (math.random() - 0.5) * 0.8
		dy = dy + (math.random() - 0.5) * 0.8
	end
	if HAS_MOUSEREL then
		pcall(mousemoverel, math.floor(dx + 0.5), math.floor(dy + 0.5))
	elseif VIM then
		pcall(function() VIM:SendMouseMoveEvent(cur.X + dx, cur.Y + dy, false) end)
	end
end

local function aimEngaged()
	if not CONFIG.aim.enabled then return false end
	if CONFIG.aim.autoMobile and UIS.TouchEnabled and not UIS.KeyboardEnabled then return true end
	if CONFIG.aim.lockToggle then return AIM.locked end
	return AIM.holding
end

local function aimStep()
	if not CONFIG.aim.enabled then AIM.target = nil; return end
	local cam = Workspace.CurrentCamera
	if not cam then return end

	if not aimEngaged() then AIM.target = nil; return end
	if now() - AIM.pressedAt < CONFIG.aim.reaction then return end

	local t = pickTarget(cam)
	AIM.target = t
	if not t then return end

	local aimPos = predictPoint(t.part, cam)
	if CONFIG.aim.mode == "mouse" then
		mouseAim(aimPos)
	else
		local cur = cam.CFrame
		if (aimPos - cur.Position).Magnitude < 0.25 then return end
		local desired = CFrame.lookAt(cur.Position, aimPos)
		local alpha = CONFIG.aim.smooth
		if CONFIG.aim.humanize then alpha = alpha * (0.88 + math.random() * 0.24) end
		if alpha >= 0.999 then
			cam.CFrame = desired
		else
			cam.CFrame = cur:Lerp(desired, math.clamp(alpha, 0.01, 1))
		end
	end

	if CONFIG.aim.triggerbot then fireTrigger() end
end

local function updateFov()
	if not fovCircle then return end
	local cam = Workspace.CurrentCamera
	if not cam then pcall(function() fovCircle.Visible = false end); return end
	local vp = cam.ViewportSize
	local show = aimEngaged()
	pcall(function()
		fovCircle.Position = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
		fovCircle.Radius = CONFIG.aim.fov
		fovCircle.Color = AIM.target and CONFIG.esp.enemyColor or CONFIG.esp.boxColor
		fovCircle.Visible = show
	end)
end

---------------------------------------------------------------------------
-- input
---------------------------------------------------------------------------
local function setEsp(v)
	CONFIG.esp.enabled = v
	if not v then
		for _, slot in pairs(SLOTS) do hideSlot(slot) end
	end
end

local function setAim(v)
	CONFIG.aim.enabled = v
	if not v then AIM.holding = false; AIM.locked = false end
end

table.insert(CONNS, UIS.InputBegan:Connect(function(input, gp)
	if CONFIG.aim.key and input.UserInputType == CONFIG.aim.key then
		if CONFIG.aim.lockToggle then
			AIM.locked = not AIM.locked
		else
			AIM.holding = true
		end
		AIM.pressedAt = now()
		return
	end
	if gp then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		setEsp(not CONFIG.esp.enabled)
	elseif input.KeyCode == Enum.KeyCode.F then
		CONFIG.aim.mode = (CONFIG.aim.mode == "camera") and "mouse" or "camera"
	elseif input.KeyCode == Enum.KeyCode.LeftBracket then
		CONFIG.aim.fov = math.max(20, CONFIG.aim.fov - 20)
	elseif input.KeyCode == Enum.KeyCode.RightBracket then
		CONFIG.aim.fov = math.min(1200, CONFIG.aim.fov + 20)
	end
end))

table.insert(CONNS, UIS.InputEnded:Connect(function(input)
	if CONFIG.aim.key and input.UserInputType == CONFIG.aim.key then
		if not CONFIG.aim.lockToggle then AIM.holding = false end
	end
end))

